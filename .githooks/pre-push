#!/bin/sh
# FileOrca - trava da main.
# Ligado no passo 24 da F0 com: git config core.hooksPath .githooks
# Recusa todo push que atualize ou apague a branch main no remoto, seu ou de uma run.
# Mudanca na main entra so por PR (branch fase-* ou ajuste-*), com merge do CI ou seu.

remote="$1"
blocked=0

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    blocked=1
  fi
done

if [ "$blocked" -eq 1 ]; then
  echo "" >&2
  echo "pre-push: push direto na main recusado (remoto: $remote)." >&2
  echo "Crie uma branch, suba ela e abra uma PR:" >&2
  echo "  git switch -c ajuste-assunto" >&2
  echo "  git push -u origin ajuste-assunto" >&2
  echo "  gh pr create" >&2
  echo "" >&2
  exit 1
fi

exit 0
