---
// Footer (docs/design/components/Footer): the deep sea with the wave on its top edge; column titles are
// H2; only links to pages that exist in the language. The Image column lists the hub and the tools. The Money column
// lists the language's money hub and its five credit calculators (DECISOES § 118; F6: the Brazilian hub and calculators
// in Portuguese, the Spanish ones in Spanish). The PDF column lists the hub and the first six PDF tools in hub order (F5a,
// DECISOES § 160): every PDF page is one click from the hub, so none is an orphan. In English, the Home and Health columns
// list their hub and every calculator of it, and the Utilities column the QR code generator (F7, decision 9). Under
// Utilities, in the same column, the Guides block (F11, decision 7; DECISOES § 396): "All guides", the guides hub of the
// language, and its groups that have guides in the language (#image, #pdf and #money on the hub; no money in pt). On the hub
// itself, "All guides" is the current page. An eighth column would not fit at 1280 px. Never an ad inside the footer. With
// the AdSense anchor on the page, 96px of room at the bottom on the phone.
// F12 · o café (decision 7; DECISOES § 437): the coffee line opens the footer, the first link of it, with a 48 px target.
// At the base it sat 24 to 46 px from the AdSense anchor with the page scrolled to the end; at the top, the columns lie
// between them. The base keeps only the signature.
// F13b · o rodapé no celular (decision 8; UX-17 A, pages.html; DECISOES § 587): below 768 px two columns; each category
// keeps its hub in sight as its main link (48 px) and puts its tools in a <details> (fo-footer__tools; fo-footer__more is the
// Guides block of the F11), whose links keep the 32 px line of before (the exception b-04 of § 381). The Guides block does
// the same: "All guides" in sight, its groups in a disclosure. The QR code under Utilities and the FileOrca column (in one
// wrapping row, the whole width) are links in sight, 48 px too, with no disclosure. From
// 768 px, where the browser styles ::details-content, the summary goes away and the footer is the one of before: the same
// links in the same order, the hub on the 32 px line it had in the list. No script, no link twice, no Oli.
import type { Lang, RouteId } from '../i18n/routes.ts';
import { QR_ID, moneyHubId, pagePath, pathFor, routeById } from '../i18n/routes.ts';
import { TEXTS } from '../i18n/texts.ts';
import type { CommonTexts } from '../i18n/types.ts';
import { fmt, groupDigits } from '../i18n/format.ts';
import { toolCounts } from './tool-count.ts';
import { AUTHOR } from '../platform/site.ts';
import { IMAGE_TOOL_IDS } from '../tools/image/registry.ts';
import { HOME_MONEY_IDS, LIFE_HUB_IDS, LIFE_HUB_ROUTE, type LifeHub } from '../tools/calc/registry.ts';
import { PDF_HUB_ID, PDF_TOOL_IDS } from '../tools/pdf/registry.ts';
import { GUIDES_HUB_ID } from '../tools/guides/registry.ts';
import { HUB_GROUPS, hubGroup } from '../tools/guides/hub.ts';
import Icon from './Icon.astro';

/** How many PDF tools the footer column lists after the hub: the six of the highest search volume. */
const FOOTER_PDF_TOOLS = 6;

interface Props {
  lang: Lang;
  t: CommonTexts;
  /** The page loads AdSense (so the anchor may cover the bottom of the screen). */
  anchor: boolean;
  /** The route of the page: on the guides hub, "All guides" is the current page. */
  current?: RouteId;
}
const { lang, t, anchor, current } = Astro.props;
const year = new Date().getUTCFullYear();
const hub = routeById('image-tools').paths[lang];
const image = [
  ...(hub && t.imageTools ? [{ label: t.imageTools, href: hub }] : []),
  ...IMAGE_TOOL_IDS.flatMap((id) => {
    const href = routeById(id).paths[lang];
    const blurb = t.tools[id];
    return href && blurb ? [{ label: blurb.name, href }] : [];
  }),
];
const pdfHub = routeById(PDF_HUB_ID).paths[lang];
const pdf =
  pdfHub && t.pdfTools && t.pdf && t.footer.pdfColumn
    ? [
        { label: t.pdfTools, href: pdfHub },
        ...PDF_TOOL_IDS.slice(0, FOOTER_PDF_TOOLS).flatMap((id) => {
          const href = routeById(id).paths[lang];
          const blurb = t.pdf?.[id];
          return href && blurb ? [{ label: blurb.name, href }] : [];
        }),
      ]
    : [];
const moneyHub = pagePath(moneyHubId(lang), lang);
const money = moneyHub
  ? [
      { label: t.moneyCalculators, href: moneyHub },
      ...HOME_MONEY_IDS[lang].flatMap((id) => {
        const href = pagePath(id, lang);
        const blurb = t.calcs[id];
        return href && blurb ? [{ label: blurb.name, href }] : [];
      }),
    ]
  : [];
/** The home and health columns (English only, F7): the hub and every calculator of it, so none is an orphan. */
const life = (hubId: LifeHub, name: string | undefined, title: string | undefined) => {
  const hubPath = pagePath(LIFE_HUB_ROUTE[hubId], lang);
  if (!hubPath || !name || !title) return null;
  const links = [
    { label: name, href: hubPath },
    ...LIFE_HUB_IDS[hubId].flatMap((id) => {
      const href = pagePath(id, lang);
      const blurb = t.calcs[id];
      return href && blurb ? [{ label: blurb.name, href }] : [];
    }),
  ];
  return { title, links, hubId };
};
const lifeColumns = [life('house', t.homeCalculators, t.footer.homeColumn), life('health', t.healthCalculators, t.footer.healthColumn)].filter((column) => column !== null);
/**
 * F13b (UX-17 A; DECISOES § 587): the category columns. Each keeps its hub (the first link) in sight and puts its tools in
 * a disclosure below 768 px. Its summary says "All 11" when the list holds every tool of the category in the language (the
 * count of the Menu, src/components/tool-count.ts) and "6 popular" when it holds some, and the screen reader hears the
 * rest ("All 11 image tools"). From 768 px the summary goes away and the list shows as before (::details-content).
 */
const counts = toolCounts(lang);
const category = (title: string | undefined, links: readonly { label: string; href: string }[], total: number, noun: string | undefined) => {
  const [hub, ...tools] = links;
  if (!title || !hub || !noun) return null;
  const all = tools.length >= total;
  const n = groupDigits(tools.length, lang);
  return { title, hub, tools, shown: fmt(all ? t.footer.tools.all : t.footer.tools.popular, { n }), rest: all ? noun : fmt(t.footer.tools.popularRest, { noun }) };
};
const lifeTotal = { house: counts.house, health: counts.health } as const;
const lifeNoun = { house: t.footer.tools.home, health: t.footer.tools.health } as const;
const categories = [
  category(t.footer.imageColumn, image, counts.image, t.footer.tools.image),
  ...(pdf.length > 0 ? [category(t.footer.pdfColumn, pdf, counts.pdf, t.footer.tools.pdf)] : []),
  ...(money.length > 0 ? [category(t.footer.moneyColumn, money, counts.money, t.footer.tools.money)] : []),
  ...lifeColumns.map((column) => category(column.title, column.links, lifeTotal[column.hubId], lifeNoun[column.hubId])),
].filter((column) => column !== null);
const qrPath = pagePath(QR_ID, lang);
const utility = qrPath && t.qr && t.footer.utilityColumn ? { title: t.footer.utilityColumn, links: [{ label: t.qr.name, href: qrPath }] } : null;
/** The Guides block: the hub of the language, then each group of the hub that has a guide in the language. */
const guidesHub = pagePath(GUIDES_HUB_ID, lang);
const guides = guidesHub
  ? {
      title: t.guidesHub,
      links: [
        { label: t.footer.guidesAll, href: guidesHub, here: current === GUIDES_HUB_ID },
        ...HUB_GROUPS.filter((group) => hubGroup(group, lang).length > 0).map((group) => ({ label: TEXTS[lang].guides.groups[group].heading, href: `${guidesHub}#${group}`, here: false })),
      ],
    }
  : null;
/** F13b (UX-17 A; DECISOES § 587): the Guides block the same way, "All guides" in sight and the groups in a disclosure. */
const guidesBlock = guides
  ? (() => {
      const [hub, ...groups] = guides.links;
      return hub ? { title: guides.title, hub, groups, shown: fmt(t.footer.guidesTopics, { n: groupDigits(groups.length, lang) }), rest: t.footer.guidesTopicsRest } : null;
    })()
  : null;
const site = [
  { label: t.footer.about, href: pathFor('about', lang) },
  { label: t.footer.privacy, href: pathFor('privacy', lang) },
  { label: t.footer.terms, href: pathFor('terms', lang) },
  { label: t.footer.licenses, href: pathFor('licenses', lang) },
  { label: t.footer.contact, href: pathFor('contact', lang) },
];
---
<footer class:list={['fo-footer fo-deep', { 'fo-footer--anchor': anchor }]}>
  <p class="fo-footer__coffee-row"><a class="fo-footer__coffee" href={pathFor('support', lang)} data-track="donate_click" data-track-place="footer"><Icon name="coffee" />{t.footer.coffee}</a></p>
  <div class="fo-footer__cols">
    {categories.map((column) => (
      <div class="fo-footer__col">
        <h2>{column.title}</h2>
        <a class="fo-footer__hub" href={column.hub.href}>{column.hub.label}</a>
        {column.tools.length > 0 && (
          <details class="fo-footer__tools">
            <summary><span>{column.shown}<span class="fo-sr">{` ${column.rest}`}</span></span><Icon name="chevron-down" class="fo-icon--sm" /></summary>
            <ul>{column.tools.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>
          </details>
        )}
      </div>
    ))}
    {(utility || guides) && (
      <div class="fo-footer__col">
        {utility && (
          <>
            <h2>{utility.title}</h2>
            <ul class="fo-footer__solo">{utility.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>
          </>
        )}
        {guidesBlock && (
          <div class="fo-footer__more">
            <h2>{guidesBlock.title}</h2>
            <a class="fo-footer__hub" href={guidesBlock.hub.href} aria-current={guidesBlock.hub.here ? 'page' : undefined}>{guidesBlock.hub.label}</a>
            {guidesBlock.groups.length > 0 && (
              <details class="fo-footer__tools">
                <summary><span>{guidesBlock.shown}<span class="fo-sr">{` ${guidesBlock.rest}`}</span></span><Icon name="chevron-down" class="fo-icon--sm" /></summary>
                <ul>{guidesBlock.groups.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>
              </details>
            )}
          </div>
        )}
      </div>
    )}
    <div class="fo-footer__col fo-footer__col--site">
      <h2>{t.footer.siteColumn}</h2>
      <ul>{site.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>
    </div>
  </div>
  <div class="fo-footer__base">
    <span>{fmt(t.footer.signature, { name: AUTHOR.name, city: AUTHOR.city })} · © {year}</span>
  </div>
</footer>
