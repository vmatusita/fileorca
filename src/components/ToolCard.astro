---
// ToolCard (docs/design/components/ToolCard): the whole card is a link, with the folded corner in the
// category colour; name in an H3; it lifts on hover (a card leads, a button acts: no lip).
import type { IconName } from '../icons/svg.ts';
import Icon from './Icon.astro';

interface Props {
  href: string;
  name: string;
  description: string;
  category: 'image';
  icon: IconName;
}
const { href, name, description, category, icon } = Astro.props;
---
<a class={`fo-tool fo-dogear fo-cat--${category}`} href={href}>
  <span class="fo-tool__icon" aria-hidden="true"><Icon name={icon} /></span>
  <h3 class="fo-tool__name">{name}</h3>
  <p class="fo-tool__desc">{description}</p>
</a>
