---
// SupportCard (docs/design/components/SupportCard, DECISOES § 48): the Oli with her mug, the title at
// the level of the page (the H1 on the support page), who makes the site and one neutral button to
// Ko-fi, with the suggested amounts in text (the Ko-fi link carries no amount, so no amount buttons).
// No Ko-fi script or widget. On the Portuguese page it also carries the Pix block (.fo-pix; F6, decision 8): the
// amounts in an OptionGroup, the static QR of each one (built here, in SVG), its "copia e cola" with a Copy button and
// the receiver's name. The choice of amount is CSS only (:has(:checked) shows the block of the checked amount); the
// copy is the one inline script below. Nothing leaves the page for the Pix: the codes are in the HTML.
// F12 · o café (decision 7): the title and the text of PLANO-MELHORIAS section C; the Oli to the right of the title,
// looking left at the text (DECISOES § 438); in the Pix, the "Pix copia e cola" label is visible (it was for screen
// readers only), Copy code is a plain 52 px button, and on the phone it comes before the QR (DECISOES § 440). The
// Ko-fi button stays after the Pix: in Portuguese the two ways sit side by side on this page, and the result card
// carries only the Pix.
import type { SupportTexts } from '../i18n/types.ts';
import { fmt } from '../i18n/format.ts';
import { KOFI_URL } from '../platform/site.ts';
import { PIX_AMOUNTS, PIX_NAME, sitePixCode } from '../platform/pix.ts';
import { qrSvg } from '../platform/pix-qr.ts';
import { AUTHOR } from '../platform/site.ts';
import Icon from './Icon.astro';
import Oli from './Oli.astro';

interface Props {
  t: SupportTexts;
  level: 1 | 2 | 3;
}
const { t, level } = Astro.props;
const Heading = `h${level}` as const;
const PixHeading = `h${Math.min(level + 1, 6)}` as 'h2' | 'h3' | 'h4';
const pix = t.pix;
// "5.00" is the BR Code's amount; the page writes it the Brazilian way, "5".
const amountText = (amount: string) => fmt(pix?.amount ?? '{amount}', { amount: String(Number(amount)) });
const amounts = pix
  ? PIX_AMOUNTS.map((amount) => {
      const code = sitePixCode(amount);
      const value = amount === null ? 'any' : String(Number(amount));
      const spoken = amount === null ? pix.anyLower : amountText(amount);
      return { value, label: amount === null ? pix.any : amountText(amount), code, qr: qrSvg(code, fmt(pix.qrLabel, { amount: spoken })).svg };
    })
  : [];
// The last word of the Ko-fi button stays whole when the label wraps on the phone: "(Ko-fi)" never breaks at its hyphen.
const [, buttonHead = t.button, buttonTail = ''] = /^(.*\s)(\S+)$/.exec(t.button) ?? [];
// The receiver as the person knows him, not the upper case of the BR Code.
const receiver = pix ? fmt(pix.receiver, { name: PIX_NAME === AUTHOR.name.toUpperCase() ? AUTHOR.name : PIX_NAME }) : '';
---
<section class="fo-support" aria-labelledby="fo-support-title">
  <div class="fo-support__head">
    <Heading id="fo-support-title">{t.h1}</Heading>
    <Oli pose="coffee" class="fo-support__oli" />
  </div>
  <p>{t.body}</p>
  {pix && (
    <div class="fo-pix-card" id="pix">
      <PixHeading class="fo-h3" id="fo-pix-title">{pix.heading}</PixHeading>
      <div class="fo-seg" role="radiogroup" aria-label={pix.legend}>
        {amounts.map((entry, index) => (
          <label class="fo-seg__opt"><input type="radio" name="fo-pix-amount" value={entry.value} checked={index === 0} />{entry.label}</label>
        ))}
      </div>
      {amounts.map((entry) => (
        <div class="fo-pix" data-pix={entry.value}>
          <Fragment set:html={entry.qr} />
          <div class="fo-pix__side">
            <p class="fo-pix__label">{pix.codeLabel}</p>
            <div class="fo-pix__code"><code>{entry.code}</code></div>
            <button class="fo-btn" type="button" data-pix-copy={entry.code} data-track="donate_click" data-track-place="pix">{pix.copy}</button>
            <span class="fo-pix__receiver">{receiver}</span>
          </div>
        </div>
      ))}
      <p class="fo-pix__status" role="status" data-pix-copied={pix.copied} data-pix-failed={pix.copyFailed}></p>
      <p class="fo-support__amounts">{pix.note}</p>
    </div>
  )}
  <a class="fo-btn" href={KOFI_URL} rel="noopener" data-track="donate_click" data-track-place="support_page"><Icon name="coffee" class="fo-icon--sm" /><span>{buttonHead}<span class="fo-support__last">{buttonTail}</span></span></a>
  <p class="fo-support__amounts">{t.amountsNote}</p>
</section>
{pix && (
  <script is:inline>
    document.addEventListener('click', (event) => {
      const button = event.target instanceof Element ? event.target.closest('[data-pix-copy]') : null;
      const status = document.querySelector('[data-pix-copied]');
      if (!button || !status) return;
      const say = (key) => {
        status.textContent = status.getAttribute(key);
      };
      // A browser without the clipboard, or one that refuses the copy, says how to copy by hand (DECISOES § 245).
      if (!navigator.clipboard) return say('data-pix-failed');
      navigator.clipboard.writeText(button.getAttribute('data-pix-copy') || '').then(() => say('data-pix-copied'), () => say('data-pix-failed'));
    });
    // Another amount is another code: the "copied" of the last one no longer holds.
    document.addEventListener('change', (event) => {
      const status = document.querySelector('[data-pix-copied]');
      if (status && event.target instanceof Element && event.target.matches('input[name="fo-pix-amount"]')) status.textContent = '';
    });
  </script>
)}
