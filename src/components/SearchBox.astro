---
// ToolSearch markup (combobox + named listbox). Used inside the modal dialog and inline on the 404. F11 (decision 7): the
// listbox holds the two groups of results, the tools and then the guides, whose titles the list carries in data-tools and
// data-guides (src/search/search.ts writes the groups on first use).
// Without a result the Oli peeks from the bottom edge of the box (pose peek, in every page's sprite).
import type { CommonTexts } from '../i18n/types.ts';
import Icon from './Icon.astro';
import Oli from './Oli.astro';

interface Props {
  t: CommonTexts;
  id: string;
  /** Inside the dialog: shows the Esc hint at the end of the field. */
  dialog?: boolean;
}
const { t, id, dialog = false } = Astro.props;
---
<div class="fo-search">
  <div class="fo-search__field">
    <Icon name="search" />
    <input
      type="search"
      role="combobox"
      aria-label={t.search.inputLabel}
      aria-expanded="false"
      aria-controls={`${id}-list`}
      aria-autocomplete="list"
      autocomplete="off"
      placeholder={t.search.placeholder}
    />
    {dialog && <span class="fo-kbd fo-desktop-only" aria-hidden="true">Esc</span>}
  </div>
  <div class="fo-search__list" id={`${id}-list`} role="listbox" aria-label={t.search.listLabel} data-tools={t.search.toolsGroup} data-guides={t.search.guidesGroup} hidden></div>
  <div class="fo-search__empty" data-search-empty data-title={t.search.emptyTitle} hidden>
    <p class="fo-h3" data-search-empty-title></p>
    <p class="fo-muted">{t.search.emptyHint}</p>
    <Oli pose="peek" class="fo-search__peek" />
  </div>
  <!-- Says "no tool called …" to a screen reader too; outside the hidden block so it is always in the tree (WCAG 4.1.3, DECISOES § 101). -->
  <p class="fo-sr" role="status" data-search-status></p>
</div>
