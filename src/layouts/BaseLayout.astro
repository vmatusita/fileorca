---
// Base layout of every page: technical SEO head, the theme and the consent bootstraps first, the Fredoka preload, the Oli
// sprite of the page, header, footer, cookie notice, the lazy tool search and the registration of the service
// worker (F8, after the load event). Noindex comes only from the _headers file (DECISOES § 12).
// The theme (F11, DECISOES § 385 and § 386): the color-scheme meta says both schemes before the CSS arrives, and the
// <head> script right after it puts the stored choice (fo-theme) on <html> and in that meta before any CSS (Astro puts the
// stylesheet last in <head>), so the first paint is already in the chosen theme. The theme-color stays one, the deep sea.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieNotice from '../components/CookieNotice.astro';
import SearchDialog from '../components/SearchDialog.astro';
import AdsenseHead from '../ads/AdsenseHead.astro';
import { consentBootstrap } from '../analytics/consent.ts';
import { themeBootstrap } from '../platform/theme.ts';
import { LANG_TAG, OG_LOCALE, pathFor, type Lang, type RouteDef } from '../i18n/routes.ts';
import { TEXTS } from '../i18n/texts.ts';
import { absolute, alternatesFor, graph, ogImagePath, organizationLd, pageTitle } from '../seo/meta.ts';
import { SITE_NAME, SW_ENABLED } from '../platform/site.ts';
import { swRegistration } from '../platform/sw-register.ts';
import { APP_ICON_SVG } from '../seo/images.ts';
import { buildAdsConfig, wallModeOf } from '../ads/config.ts';
// F12 · o mapa de anúncios (DECISOES § 419 and § 420).
import { layOutAds, markProblems, withoutMarks } from '../ads/map.ts';
import type { AdArea } from '../i18n/routes.ts';
import OliSprite from '../components/OliSprite.astro';
import type { Pose } from '../oli/poses.ts';
/* F12 · a parede do bloqueador (§ 426) */
import AdblockWall from '../components/AdblockWall.astro';
import { WALL_POSE } from '../oli/poses.ts';
// The same hashed URL as the url() of the @font-face in src/styles/fonts.css (DECISOES § 42).
import fredokaUrl from '@fontsource-variable/fredoka/files/fredoka-latin-wght-normal.woff2?url';

interface Props {
  lang: Lang;
  route: RouteDef;
  title: string;
  description: string;
  /** Extra JSON-LD nodes (BreadcrumbList, WebApplication, Person…). */
  schema?: Record<string, unknown>[];
  /** Pages with AdSlots (tool pages). Legal and institutional pages never have ads. */
  withAds?: boolean;
  /** F12 · o mapa de anúncios: the ad area of a page with ads, whose units its boxes use (the adArea of the route map). */
  adArea?: AdArea;
  /** Oli poses the page shows, client states included; the search peek is always added. */
  oli?: readonly Pose[];
  /** F13a · o aviso compacto (DECISOES § 458): the seal the cookie notice repeats, the page's own (numbers, text);
   *  common.seal (files) where the page passes none. */
  seal?: string;
}
const { lang, route, title, description, schema = [], withAds = false, adArea, oli = [], seal } = Astro.props;
const adsConfig = buildAdsConfig();
/* F12 · a parede do bloqueador (§ 426): only on a page with ads and with the wall on; its pose joins the sprite there. */
const wall = withAds ? wallModeOf(adsConfig) : 'desligado';
const poses: Pose[] = [...new Set<Pose>([...oli, 'peek', ...(wall === 'desligado' ? [] : [WALL_POSE])])];
const anchor = withAds && adsConfig.scriptEnabled;
const common = TEXTS[lang].common;
const path = route.paths[lang] ?? '/';
const canonical = absolute(path);
const alternates = alternatesFor(route);
const fullTitle = pageTitle(title);
const ogImage = absolute(ogImagePath(route.indexable ? route.id : 'home', lang));
// F12 · o mapa de anúncios (decision 3; DECISOES § 419 and § 420): <main> is rendered to text, the build puts each ad
// box at the marks of the view (src/ads/map.ts) and drops the marks, and the rail gets its boxes; a box exists only with
// the id of its unit. A mark in a wrong place fails the build, on a page with ads or without.
// F12, Mudança 10 (DECISOES § 413): a page with ads keeps the rail column of the grid from 1280px, empty when the build has
// no unit for it, so the content, the header and the footer keep the same edges in the default build and with the ads.
const rawMain = await Astro.slots.render('default');
const adPage = withAds && adArea !== undefined;
const markErrors = adPage ? [] : markProblems(rawMain, false);
if (markErrors.length) throw new Error(`mapa de anúncios em ${path}: ${markErrors.join('; ')}`);
const ads = withAds && adArea ? layOutAds(rawMain, { area: adArea, label: common.adLabel, config: adsConfig }) : null;
const mainHtml = ads ? ads.main : withoutMarks(rawMain);
const hasRail = adPage;
const railHtml = ads?.rail ?? '';
const trackScript = `document.addEventListener('click',function(e){var a=e.target.closest('[data-track]');if(a&&window.foTrack){var p={lang:${JSON.stringify(lang)}};if(a.dataset.trackPlace)p.place=a.dataset.trackPlace;foTrack(a.dataset.track,p);}});`;
---
<!doctype html>
<html lang={LANG_TAG[lang]} data-lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline set:html={themeBootstrap()} />
    <script is:inline set:html={consentBootstrap()} />
    <title>{fullTitle}</title>
    <link rel="preload" href={fredokaUrl} as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    {route.indexable && <link rel="canonical" href={canonical} />}
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={OG_LOCALE[lang]} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0C2B5E" />
    <link rel="icon" href={`data:image/svg+xml,${encodeURIComponent(APP_ICON_SVG)}`} type="image/svg+xml" />
    <link rel="manifest" href={`/manifest-${lang}.webmanifest`} />
    <link rel="apple-touch-icon" href="/icon-180.png" />
    <AdsenseHead withAds={withAds} />
    <script type="application/ld+json" is:inline set:html={graph(organizationLd(), ...schema)} />
  </head>
  <body>
    <OliSprite poses={poses} />
    <a class="fo-skip" href="#main">{common.skipToContent}</a>
    <Header lang={lang} route={route} t={common} />
    <div class:list={['fo-frame', { 'fo-frame--rail': hasRail }]}>
      <main id="main" class="fo-main fo-content"><Fragment set:html={mainHtml} /></main>
      {railHtml && <aside class="fo-rail" aria-label={common.adLabel}><Fragment set:html={railHtml} /></aside>}
    </div>
    {ads?.push && <script is:inline set:html={ads.push} />}
    <Footer lang={lang} t={common} anchor={anchor} current={route.id} />
    <CookieNotice t={common} privacyHref={pathFor('privacy', lang)} seal={seal ?? common.seal} />
    <SearchDialog t={common} />
    {wall !== 'desligado' && <AdblockWall lang={lang} mode={wall} />}
    <script is:inline set:html={trackScript} />
    {SW_ENABLED && <script is:inline set:html={swRegistration()} />}
  </body>
</html>
