---
// Support page (DECISOES § 5 and § 48): the SupportCard, whose title is the page H1, then who makes the
// site and what the next coffee pays for. No Ko-fi widget or script; donate_click with support_page. The last crumb is the
// name of the row of the header Menu, "Support Oli" (F12, decision 7; DECISOES § 438).
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import SupportCard from '../components/SupportCard.astro';
import { routeById, type Lang } from '../i18n/routes.ts';
import { TEXTS } from '../i18n/texts.ts';
import { AUTHOR } from '../platform/site.ts';
import { breadcrumbLd, homePath } from '../seo/meta.ts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const route = routeById('support');
const t = TEXTS[lang].support;
const common = TEXTS[lang].common;
const crumbs = [
  { name: common.breadcrumb.home, path: homePath(lang) },
  { name: common.header.support, path: route.paths[lang] ?? '/' },
];
---
<BaseLayout lang={lang} route={route} title={t.title} description={t.description} schema={[breadcrumbLd(crumbs)]} oli={['coffee']}>
  <Breadcrumb label={common.breadcrumb.label} crumbs={crumbs} />
  <SupportCard t={t} level={1} />
  <article class="fo-prose">
    <h2>{t.whoHeading}</h2>
    <p>{t.who} <a href={AUTHOR.website} rel="me">vmatusita.com.br</a></p>
    <h2>{t.nextHeading}</h2>
    <p>{t.next}</p>
  </article>
</BaseLayout>
