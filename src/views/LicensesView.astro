---
// /licenses, generated at build from `dependencies` plus fonts (DECISOES § 13).
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { routeById, type Lang } from '../i18n/routes.ts';
import { TEXTS } from '../i18n/texts.ts';
import { browserPackages } from '../platform/licenses.ts';
import { breadcrumbLd, homePath } from '../seo/meta.ts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const route = routeById('licenses');
const t = TEXTS[lang].licenses;
const common = TEXTS[lang].common;
const all = browserPackages();
const groups = [
  { heading: t.packagesHeading, items: all.filter((item) => !item.font), empty: null },
  { heading: t.fontsHeading, items: all.filter((item) => item.font), empty: t.noFonts },
];
const crumbs = [
  { name: common.breadcrumb.home, path: homePath(lang) },
  { name: t.h1, path: route.paths[lang] ?? '/' },
];
---
<BaseLayout lang={lang} route={route} title={t.title} description={t.description} schema={[breadcrumbLd(crumbs)]}>
  <Breadcrumb label={common.breadcrumb.label} crumbs={crumbs} />
  <h1 class="fo-h1">{t.h1}</h1>
  <p class="fo-prose">{t.intro}</p>
  {groups.map((group) => (
    <section class="fo-section">
      <h2>{group.heading}</h2>
      {group.items.length === 0 ? <p>{group.empty}</p> : (
        <table class="fo-table">
          <thead><tr><th scope="col">{t.packageColumn}</th><th scope="col">{t.versionColumn}</th><th scope="col">{t.licenseColumn}</th></tr></thead>
          <tbody>
            {group.items.map((item) => (
              <tr>
                <td>{item.repository ? <a href={item.repository} rel="noopener">{item.name}</a> : item.name}</td>
                <td>{item.version}</td>
                <td>
                  {item.license}
                  {item.text && <details><summary>{t.showText}</summary><pre>{item.text}</pre></details>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </section>
  ))}
</BaseLayout>
