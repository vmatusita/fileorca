---
// The money hub /money-calculators/ (F4; DECISOES § 118), on the mold of /image-tools/ (§ 77 and § 96):
// eyebrow, H1 and one line in the money band; the calculators, the credit ones first; one content AdSlot;
// the presets with their links; the guides; "how these calculators work" with the data-ymyl blocks of
// gate:dinheiro-saude (formula, assumptions, a worked example from the engine, official sources, "Reviewed
// by" and the notice); the rail AdSlot. The same view serves the English hub, its Spanish version (the same 14
// calculators, 4 presets and 5 guides since the languages adjustment) and the Brazilian hub in Portuguese (the eight adapted
// ones, with no preset and no guide), each with the pages of its language (prompt F6, decisions 5 and 6).
// F12 · o mapa de anúncios (decision 3; DECISOES § 419): the first content ad after the grid of the credit calculators
// (before, after both grids), the next ones only at the marks between the sections and in "How these calculators work",
// never against the table of the presets nor the one of the example; the layout puts each box and the rails.
import BaseLayout from '../layouts/BaseLayout.astro';
// F13b (decision 7; UX-15 A; DECISOES § H-9): the sea at the foot of the band.
import HubSea from '../components/HubSea.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ToolCard from '../components/ToolCard.astro';
import AdBreak from '../ads/AdBreak.astro';
import Reviewed from '../tools/calc/Reviewed.astro';
import { moneyHubId, routeById, type Lang } from '../i18n/routes.ts';
import { TEXTS } from '../i18n/texts.ts';
import { breadcrumbLd, collectionPageLd, homePath, personLd } from '../seo/meta.ts';
import { CALC_PRESET_IDS, GUIDE_IDS, HUB_MONEY_IDS, guidePathIn, moneyPage, type MoneyPageId } from '../tools/calc/registry.ts';
import { SHARED_BY_LANG, cardOf, datesOf, longDate, workedExample } from '../tools/calc/page.ts';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const route = routeById(moneyHubId(lang));
const path = route.paths[lang] ?? '/';
const common = TEXTS[lang].common;
const t = TEXTS[lang]['money-calculators'];
const shared = SHARED_BY_LANG[lang].page;
/** The calculator of the worked example: the mortgage, and the SAC × PRICE in the Brazilian hub. */
const exampleOf: MoneyPageId = lang === 'pt' ? 'br-sac-price' : 'mortgage-calculator';
const crumbs = [
  { name: common.breadcrumb.home, path: homePath(lang) },
  { name: common.moneyCalculators, path },
];
const inGroup = (group: 'credit' | 'educational') => HUB_MONEY_IDS[lang].filter((id) => moneyPage(id, lang)?.group === group).map((id) => cardOf(id, lang));
const groups = [
  { id: 'credit', heading: t.creditHeading, cards: inGroup('credit') },
  { id: 'savings', heading: t.educationalHeading, cards: inGroup('educational') },
].filter((group) => group.cards.length > 0);
// The presets and the guides of the language: English and Spanish have them, the Brazilian hub has none.
const presets = CALC_PRESET_IDS.filter((id) => moneyPage(id, lang)).map((id) => cardOf(id, lang));
const guides = GUIDE_IDS.flatMap((id) => {
  const blurb = common.guides?.[id];
  const href = guidePathIn(id, lang);
  return blurb && href ? [{ href, blurb }] : [];
});
const list = [...groups.flatMap((group) => group.cards), ...presets].map((card) => ({ name: card.name, path: card.href }));
const example = workedExample(exampleOf, lang);
const [readBefore, readAfter] = shared.readOn.split('{date}');
const read = datesOf('money', lang).read;
---
<BaseLayout
  lang={lang}
  oli={['swim']}
  route={route}
  title={t.title}
  description={t.description}
  withAds
  adArea="dinheiro"
  seal={common.calcSeal}
  schema={[breadcrumbLd(crumbs), collectionPageLd(t.h1, t.description, path, lang, list), personLd()]}
>
  <Breadcrumb label={common.breadcrumb.label} crumbs={crumbs} />
  <div class="fo-hubband fo-hubband--sea fo-cat--money">
    <span class="fo-eyebrow">{t.eyebrow}</span>
    <h1 class="fo-h1 fo-h1--display">{t.h1}</h1>
    <p class="fo-muted">{t.intro}</p>
    <Reviewed lang={lang} />
    <HubSea />
  </div>
  {groups.map((group, index) => (
    <>
      {index > 0 && <AdBreak first={index === 1} />}
      <section class="fo-section" aria-labelledby={`calcs-${group.id}`}>
        <h2 id={`calcs-${group.id}`}>{group.heading}</h2>
        <ul class="fo-grid">
          {group.cards.map((card) => (
            <li><ToolCard href={card.href} name={card.name} description={card.description} category="money" icon={card.icon} /></li>
          ))}
        </ul>
      </section>
    </>
  ))}
  <AdBreak first={groups.length === 1} />
  {presets.length > 0 && t.presetsHead && (
    <section class="fo-section fo-prose" aria-labelledby="presets">
      <h2 id="presets">{t.presetsHeading}</h2>
      <table class="fo-table">
        <caption class="fo-sr">{t.presetsCaption}</caption>
        <thead><tr><th scope="col">{t.presetsHead[0]}</th><th scope="col">{t.presetsHead[1]}</th></tr></thead>
        <tbody>
          {presets.map((preset) => <tr><th scope="row"><a href={preset.href}>{preset.name}</a></th><td>{preset.description}</td></tr>)}
        </tbody>
      </table>
    </section>
  )}
  {guides.length > 0 && (
    <section class="fo-section fo-prose" aria-labelledby="guides">
      <h2 id="guides">{t.guidesHeading}</h2>
      <ul>
        {guides.map((guide) => <li><a href={guide.href}>{guide.blurb.name}</a>: {guide.blurb.description}</li>)}
      </ul>
    </section>
  )}
  {guides.length > 0 && <AdBreak />}
  <section class="fo-section fo-prose" aria-labelledby="works">
    <h2 id="works">{t.worksHeading}</h2>
    {t.worksIntro.map((paragraph, at) => <>{at > 0 && <AdBreak />}<p>{paragraph}</p></>)}
    <AdBreak />
    <div data-ymyl="formula">
      <h3 class="fo-h3">{t.formulaHeading}</h3>
      {t.formula.map((paragraph, at) => <>{at > 0 && <AdBreak />}<p>{paragraph}</p></>)}
    </div>
    <AdBreak />
    <div data-ymyl="premises">
      <h3 class="fo-h3">{t.premisesHeading}</h3>
      <ul>{t.premises.map((premise) => <li>{premise}</li>)}</ul>
    </div>
    <AdBreak />
    <div data-ymyl="example">
      <h3 class="fo-h3">{t.exampleHeading}</h3>
      <p>{t.exampleIntro}</p>
      <table class="fo-table">
        <caption class="fo-sr">{shared.exampleResults}</caption>
        <tbody>{example.results.slice(0, 3).map(([label, value]) => <tr><th scope="row">{label}</th><td>{value}</td></tr>)}</tbody>
      </table>
      <p>{example.sentence}</p>
    </div>
    <AdBreak />
    <div data-ymyl="source">
      <h3 class="fo-h3">{t.sourcesHeading}</h3>
      <ul>{t.sources.map((source) => <li><a href={source.href}>{source.label}</a>. {readBefore}<time datetime={read}>{longDate(read, lang)}</time>{readAfter}</li>)}</ul>
    </div>
    <AdBreak />
    <div data-ymyl="disclaimer">
      <h3 class="fo-h3">{t.disclaimerHeading}</h3>
      <p>{t.disclaimer}</p>
    </div>
  </section>
</BaseLayout>
