---
// A file guide /guides/<slug>/ (prompt F5b, decision 4; DECISOES § 184): breadcrumb Home › Guides › H1 (F11; before,
// Home › Image tools or PDF tools › H1); the H1, the question it answers and the "Reviewed" line; the introduction; the embedded tool, the same island and
// entry as the tool's own page (an image tool comes in through the "tool" slot from the page file; a PDF tool is the
// PdfIsland of the 12 PDF pages), with the link to the tool's page; the first half of the text; one content AdSlot,
// only after the tool; the second half; "What we measured", every cell from data/guides-measured.json, with the date,
// the sample and the method; the sources, with the day they were read; the related pages (F11, decision 7: a guide among
// them is a GuideCard, never a ToolCard, which closes the F5b F-12); the rail AdSlot.
// Schema: Article (author Person, datePublished, dateModified), BreadcrumbList and Person. The text blocks carry
// data-guide-text, which gate:conteudo counts (800 to 1,500 words). Since the languages adjustment the same view serves the
// guides in Portuguese and Spanish, each with the tool page of its language and the numbers written in that language.
// F12 · o mapa de anúncios (decision 3; DECISOES § F12-M1): the first content ad goes into the text after the tool, with a
// paragraph between them (after the first paragraph of the first part), and the next ones only at the marks between the
// paragraphs, the lists and the parts, never beside "What we measured"; the layout puts each box and the rails
// (src/ads/map.ts). The text is one run of parts now (the `half` that split it around the one AdSlot is not read).
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ToolCard from '../components/ToolCard.astro';
import GuideCard from '../components/GuideCard.astro';
import AdBreak from '../ads/AdBreak.astro';
import PdfIsland from '../tools/pdf/PdfIsland.astro';
import Reviewed from '../tools/guides/Reviewed.astro';
import { routeById, type Lang } from '../i18n/routes.ts';
import { fmt } from '../i18n/format.ts';
import { TEXTS } from '../i18n/texts.ts';
import { articleLd, breadcrumbLd, personLd } from '../seo/meta.ts';
import { FILE_PANEL_POSES } from '../tools/image/Oli.tsx';
import { panelData as pdfPanelData } from '../tools/pdf/page.ts';
import type { PdfToolId } from '../tools/pdf/registry.ts';
import { FILE_GUIDES, type FileGuideId } from '../tools/guides/registry.ts';
import { fillValues, guideTables, longDate, placeholdersIn } from '../tools/guides/measured.ts';
import { GUIDE_PUBLISHED_ON, GUIDE_REVIEWED_ON, GUIDE_SHARED, crumbsFor, guidePath, guideTexts, relatedFor, toolInfo } from '../tools/guides/page.ts';

interface Props {
  id: FileGuideId;
  lang?: Lang;
}
const { id, lang = 'en' } = Astro.props;
const def = FILE_GUIDES[id];
const t = guideTexts(id, lang);
const shared = GUIDE_SHARED[lang];
const route = routeById(id);
const path = guidePath(id, lang);
const values = fillValues(id, t, [...placeholdersIn(t)], undefined, { lang, shared });
const fill = (text: string): string => fmt(text, values);
const crumbs = crumbsFor(id, lang);
const tool = toolInfo(def.tool, lang);
const tables = guideTables(id, shared, t, undefined, lang);
const related = relatedFor(id, lang);
const common = TEXTS[lang].common;
// The blocks of each part (its paragraphs, then its list) and the mark between two of them: the first ad after the first
// block of the first part when it has another one, or else after that part.
const blocksOf = (section: (typeof t.sections)[number]): number => section.paragraphs.length + (section.list ? 1 : 0);
const firstInside = t.sections[0] !== undefined && blocksOf(t.sections[0]) > 1;
const [readBefore, readAfter = ''] = shared.readOn.split('{date}');
---
<BaseLayout
  lang={lang}
  route={route}
  title={t.title}
  description={t.description}
  withAds
  adArea="arquivos"
  oli={FILE_PANEL_POSES}
  schema={[breadcrumbLd(crumbs), articleLd(t.h1, t.description, path, lang, GUIDE_PUBLISHED_ON[lang], GUIDE_REVIEWED_ON[lang], id), personLd()]}
>
  <Breadcrumb label={common.breadcrumb.label} crumbs={crumbs} />
  <div class="fo-top fo-top--calc" data-guide-text>
    <h1 class="fo-h1">{t.h1}</h1>
    <p class="fo-lead">{fill(t.lead)}</p>
    <Reviewed changed={fill(t.changed)} lang={lang} />
  </div>
  <div class="fo-prose fo-guide" data-guide-text>{t.intro.map((paragraph) => <p>{fill(paragraph)}</p>)}</div>
  <section class="fo-section fo-prose fo-guide__tool" aria-labelledby="guide-tool" data-guide-text>
    <h2 id="guide-tool">{t.toolHeading}</h2>
    <p>{fill(t.toolIntro)}</p>
  </section>
  {tool.pdf ? <PdfIsland data={pdfPanelData(def.tool as PdfToolId, lang)} /> : <slot name="tool" />}
  <p class="fo-guide__open"><a href={tool.path}>{fmt(shared.openTool, { name: tool.name })}</a></p>
  {t.sections.map((section, index) => (
    <>
      {index > 0 && <AdBreak first={index === 1 && !firstInside} />}
      <section class="fo-section fo-prose" aria-labelledby={`part-${index}`} data-guide-text>
        <h2 id={`part-${index}`}>{section.heading}</h2>
        {section.paragraphs.map((paragraph, at) => <>{at > 0 && <AdBreak first={index === 0 && at === 1} />}<p>{fill(paragraph)}</p></>)}
        {section.list && (
          <>
            {section.paragraphs.length > 0 && <AdBreak first={index === 0 && section.paragraphs.length === 1} />}
            <ul>{section.list.map((item) => <li>{fill(item)}</li>)}</ul>
          </>
        )}
      </section>
    </>
  ))}
  <section class="fo-section fo-prose" aria-labelledby="measured" data-content="measured">
    <h2 id="measured">{t.measuredHeading}</h2>
    <p data-guide-text>{fill(t.measuredIntro)}</p>
    {t.tables.map((table, index) => (
      <>
        {t.tables.length > 1 && <h3 class="fo-h3" id={`measured-${index}`}>{table.heading}</h3>}
        <div class="fo-table-wrap" tabindex="0" role="region" aria-label={table.caption}>
          <table class="fo-table">
            <caption class="fo-sr">{table.caption}</caption>
            <thead><tr>{table.head.map((heading) => <th scope="col">{heading}</th>)}</tr></thead>
            <tbody>{(tables[index] ?? []).map((row) => <tr>{row.map((cell, column) => (column === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>))}</tr>)}</tbody>
          </table>
        </div>
      </>
    ))}
    <p class="fo-reviewed" data-guide-text>{fill(t.measuredNote)}</p>
  </section>
  <section class="fo-section fo-prose" aria-labelledby="sources" data-content="sources">
    <h2 id="sources">{t.sourcesHeading}</h2>
    <ul>{t.sources.map((source) => <li><a href={source.href}>{source.label}</a>. {readBefore}<time datetime={source.read}>{longDate(source.read, lang)}</time>{readAfter}</li>)}</ul>
  </section>
  <AdBreak />
  <section class="fo-section" aria-labelledby="related" data-content="related">
    <h2 id="related">{t.relatedHeading}</h2>
    <ul class="fo-grid">
      {related.map((card) => (
        <li>
          {card.kind === 'guide' ? (
            <GuideCard href={card.card.href} name={card.card.name} description={card.card.description} category={card.card.category} proof={card.card.proof} tool={card.card.tool} headingLevel={3} lang={lang} />
          ) : (
            <ToolCard href={card.href} name={card.name} description={card.description} category={card.category} icon={card.icon} />
          )}
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
