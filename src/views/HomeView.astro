---
// Home: the image tools that exist in the language, with the Oli waving next to the H1, and a link to the image hub;
// the 12 PDF tools and a link to the PDF hub (F5a, DECISOES § 160); the language's credit calculators and a link to its
// money hub (F4, DECISOES § 118; F6: the Brazilian ones in Portuguese, the five translated ones in Spanish); in English, the
// home and health calculators with links to their hubs and the QR code generator (F7, decision 9); then the four guides of
// HOME_GUIDES as GuideCards, with the link to the guides hub (F11, decision 7; DECISOES § 398). The cards come from the
// route map and the registries: a page gets a card only with a path in this language. No AdSlot.
import BaseLayout from '../layouts/BaseLayout.astro';
import Oli from '../components/Oli.astro';
import ToolCard from '../components/ToolCard.astro';
import GuideCard from '../components/GuideCard.astro';
import { QR_ID, moneyHubId, pagePath, routeById, type Lang } from '../i18n/routes.ts';
import { TEXTS } from '../i18n/texts.ts';
import { SITE_ORIGIN, SITE_NAME } from '../platform/site.ts';
import { absolute } from '../seo/meta.ts';
import { IMAGE_PAGES, IMAGE_TOOL_IDS } from '../tools/image/registry.ts';
import { HOME_MONEY_IDS, LIFE_HUB_IDS, LIFE_HUB_ROUTE, moneyPage, type LifeHub } from '../tools/calc/registry.ts';
import { PDF_HUB_ID, PDF_PAGES, PDF_TOOL_IDS } from '../tools/pdf/registry.ts';
import { GUIDES_HUB_ID } from '../tools/guides/registry.ts';
import { HOME_GUIDES, hubGuides } from '../tools/guides/hub.ts';
import { guideCardData } from '../tools/guides/card.ts';
import { fmt, groupDigits } from '../i18n/format.ts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const route = routeById('home');
const t = TEXTS[lang].home;
const common = TEXTS[lang].common;
const hub = routeById('image-tools').paths[lang];
const cards = IMAGE_TOOL_IDS.flatMap((id) => {
  const href = routeById(id).paths[lang];
  const blurb = common.tools[id];
  if (!href || !blurb) return [];
  return [{ id, href, blurb, icon: IMAGE_PAGES[id].icon, category: IMAGE_PAGES[id].pdf ? ('pdf' as const) : ('image' as const) }];
});
const pdfHub = routeById(PDF_HUB_ID).paths[lang];
const pdfCards =
  pdfHub && t.pdf && common.pdf
    ? PDF_TOOL_IDS.flatMap((id) => {
        const href = routeById(id).paths[lang];
        const blurb = common.pdf?.[id];
        return href && blurb ? [{ id, href, blurb, icon: PDF_PAGES[id].icon }] : [];
      })
    : [];
const moneyHub = pagePath(moneyHubId(lang), lang);
const moneyCards = moneyHub
  ? HOME_MONEY_IDS[lang].flatMap((id) => {
      const page = moneyPage(id, lang);
      const href = pagePath(id, lang);
      const blurb = common.calcs[id];
      return page && href && blurb ? [{ href, blurb, icon: page.icon }] : [];
    })
  : [];
/** The home and the health sections: the calculators of each hub that exist in the language (English only). */
const lifeSections = (['house', 'health'] as LifeHub[]).flatMap((hubId) => {
  const texts = hubId === 'house' ? t.house : t.health;
  const href = pagePath(LIFE_HUB_ROUTE[hubId], lang);
  const cards = LIFE_HUB_IDS[hubId].flatMap((id) => {
    const page = moneyPage(id, lang);
    const blurb = common.calcs[id];
    return page && blurb ? [{ href: page.path, blurb, icon: page.icon }] : [];
  });
  return texts && href && cards.length > 0 ? [{ id: hubId, texts, href, cards }] : [];
});
const qrPath = pagePath(QR_ID, lang);
const qr = qrPath && t.qr && common.qr ? { href: qrPath, texts: t.qr, blurb: common.qr } : null;
// The "Read a guide" section: the four guides of the language, and the guides hub with the number of its guides.
const guidesHub = pagePath(GUIDES_HUB_ID, lang);
const guideCards = HOME_GUIDES[lang].map((id) => guideCardData(id, lang));
const guideCount = { n: groupDigits(hubGuides(lang).length, lang) };
const website = {
  '@type': 'WebSite',
  name: SITE_NAME,
  url: absolute(route.paths[lang] ?? '/'),
  publisher: { '@id': `${SITE_ORIGIN}/#organization` },
};
---
<BaseLayout lang={lang} route={route} title={t.title} description={t.description} schema={[website]} oli={['wave']}>
  <div class="fo-hero">
    <div class="fo-hero__text">
      <h1 class="fo-h1 fo-h1--display">{t.h1}</h1>
      <p class="fo-lead fo-prose">{t.intro}</p>
    </div>
    <Oli pose="wave" class="fo-hero__oli" />
  </div>
  <section class="fo-section" aria-labelledby="tools">
    <h2 id="tools">{t.toolsHeading}</h2>
    <ul class="fo-grid">
      {cards.map((card) => (
        <li><ToolCard href={card.href} name={card.blurb.name} description={card.blurb.description} category={card.category} icon={card.icon} /></li>
      ))}
    </ul>
    {hub && t.hubLink && <p class="fo-more"><a href={hub}>{t.hubLink}</a></p>}
  </section>
  {pdfHub && t.pdf && pdfCards.length > 0 && (
    <section class="fo-section" aria-labelledby="pdf-home">
      <h2 id="pdf-home">{t.pdf.heading}</h2>
      <p class="fo-prose">{t.pdf.intro}</p>
      <ul class="fo-grid">
        {pdfCards.map((card) => (
          <li><ToolCard href={card.href} name={card.blurb.name} description={card.blurb.description} category="pdf" icon={card.icon} /></li>
        ))}
      </ul>
      <p class="fo-more"><a href={pdfHub}>{t.pdf.hubLink}</a></p>
    </section>
  )}
  {moneyHub && t.money && moneyCards.length > 0 && (
    <section class="fo-section" aria-labelledby="money-home">
      <h2 id="money-home">{t.money.heading}</h2>
      <p class="fo-prose">{t.money.intro}</p>
      <ul class="fo-grid">
        {moneyCards.map((card) => (
          <li><ToolCard href={card.href} name={card.blurb.name} description={card.blurb.description} category="money" icon={card.icon} /></li>
        ))}
      </ul>
      <p class="fo-more"><a href={moneyHub}>{t.money.hubLink}</a></p>
    </section>
  )}
  {lifeSections.map((section) => (
    <section class="fo-section" aria-labelledby={`${section.id}-home`}>
      <h2 id={`${section.id}-home`}>{section.texts.heading}</h2>
      <p class="fo-prose">{section.texts.intro}</p>
      <ul class="fo-grid">
        {section.cards.map((card) => (
          <li><ToolCard href={card.href} name={card.blurb.name} description={card.blurb.description} category="home" icon={card.icon} /></li>
        ))}
      </ul>
      <p class="fo-more"><a href={section.href}>{section.texts.hubLink}</a></p>
    </section>
  ))}
  {qr && (
    <section class="fo-section" aria-labelledby="qr-home">
      <h2 id="qr-home">{qr.texts.heading}</h2>
      <p class="fo-prose">{qr.texts.intro}</p>
      <ul class="fo-grid">
        <li><ToolCard href={qr.href} name={qr.blurb.name} description={qr.blurb.description} category="util" icon="qr" /></li>
      </ul>
    </section>
  )}
  {guidesHub && guideCards.length > 0 && (
    <section class="fo-section" aria-labelledby="guides-home">
      <h2 id="guides-home">{t.guides.heading}</h2>
      <p class="fo-prose">{t.guides.intro}</p>
      <ul class="fo-guidecards">
        {guideCards.map((card) => (
          <li><GuideCard href={card.href} name={card.name} description={card.description} category={card.category} proof={card.proof} tool={card.tool} headingLevel={3} lang={lang} /></li>
        ))}
      </ul>
      <p class="fo-more"><a href={guidesHub}>{fmt(t.guides.hubLink, guideCount)}</a></p>
    </section>
  )}
  <section class="fo-section fo-prose" aria-labelledby="privacy-home">
    <h2 id="privacy-home">{t.privacyHeading}</h2>
    <p>{t.privacyBody}</p>
  </section>
</BaseLayout>
