---
// Home (F13b, decision 6; UX-03 B, home-b.html; DECISOES § 370 and § 567 to § 574): the sea by category. The top: the H1
// with the count of the site (src/components/tool-count.ts, § 540), the line, and the sea where the Oli swims, with the
// privacy seal on the water. Then one band per category of the language (src/components/home-bands.ts), each with its
// count, a number from its source (src/components/home-numbers.ts: measured, exact or the calculator's example; F10 p-16),
// the line that says where the number comes from, one sentence more (the words of the 3 ads by width, § 571), the tools as
// chips and the link to the hub; then the four guides of HOME_GUIDES (F11, § 398) and the privacy section.
// The ads (F12, § 419; decision 10 of the brief): marks between the blocks, the first after the image band (its top never
// on the first screen of a phone); the layout puts each box by the estimate (src/ads/map.ts). `wide`: without the rail of
// ads (the default build), <main> takes the width of the page (G-06; § 572).
import BaseLayout from '../layouts/BaseLayout.astro';
import AdBreak from '../ads/AdBreak.astro';
import Oli from '../components/Oli.astro';
import Icon from '../components/Icon.astro';
import PrivacySeal from '../components/PrivacySeal.astro';
import GuideCard from '../components/GuideCard.astro';
import { pagePath, routeById, type Lang } from '../i18n/routes.ts';
import { TEXTS } from '../i18n/texts.ts';
import type { HomeBandTexts } from '../i18n/types.ts';
import { SITE_ORIGIN, SITE_NAME } from '../platform/site.ts';
import { absolute } from '../seo/meta.ts';
import { GUIDES_HUB_ID } from '../tools/guides/registry.ts';
import { HOME_GUIDES, hubGuides } from '../tools/guides/hub.ts';
import { guideCardData } from '../tools/guides/card.ts';
import { fmt, groupDigits } from '../i18n/format.ts';
import { toolCounts } from '../components/tool-count.ts';
import { homeBands, type BandId } from '../components/home-bands.ts';
import { homeNumbers } from '../components/home-numbers.ts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const route = routeById('home');
const t = TEXTS[lang].home;
const common = TEXTS[lang].common;
const counts = toolCounts(lang);
const numbers = homeNumbers(lang);
const n = (value: number) => groupDigits(value, lang);
/** What each band says: its texts, its count and the placeholders of its number. */
const bandTexts: Record<BandId, { texts: HomeBandTexts | undefined; count: number; values: Record<string, string> }> = {
  image: { texts: t.image, count: counts.image, values: numbers.image },
  pdf: { texts: t.pdf, count: counts.pdf, values: numbers.pdf },
  money: { texts: t.money, count: counts.money, values: numbers.money },
  life: { texts: t.life, count: counts.life, values: numbers.life },
  qr: { texts: t.qr, count: counts.qr, values: numbers.qr },
};
const bands = homeBands(lang, common).flatMap((band) => {
  const { texts, count, values } = bandTexts[band.id];
  if (!texts) return [];
  const links = band.id === 'life' && t.life ? [t.life.all, t.life.allHealth] : texts.all ? [texts.all] : [];
  return [{ ...band, texts, count: fmt(texts.count, { n: n(count) }), values, links: band.hubs.flatMap((href, index) => (links[index] ? [{ href, text: fmt(links[index], { n: n(count) }) }] : [])) }];
});
// The "Read a guide" section: the four guides of the language, and the guides hub with the number of its guides.
const guidesHub = pagePath(GUIDES_HUB_ID, lang);
const guideCards = HOME_GUIDES[lang].map((id) => guideCardData(id, lang));
const guideCount = { n: groupDigits(hubGuides(lang).length, lang) };
const website = {
  '@type': 'WebSite',
  name: SITE_NAME,
  url: absolute(route.paths[lang] ?? '/'),
  publisher: { '@id': `${SITE_ORIGIN}/#organization` },
};
---
<BaseLayout lang={lang} route={route} title={t.title} description={t.description} schema={[website]} oli={['swim']} withAds adArea="geral" wide>
  <div class="fo-home-top">
    <h1 class="fo-h1 fo-h1--display">{fmt(t.h1, { n: n(counts.total) })} <span class="fo-home-top__promise">{t.h1Promise}</span></h1>
    <p class="fo-lead fo-home-top__lead">{t.intro}</p>
    <div class="fo-home-sea">
      <div class="fo-water" aria-hidden="true"></div>
      <PrivacySeal text={common.seal} />
      <Oli pose="swim" class="fo-home-sea__oli" />
    </div>
  </div>
  {bands.map((band, index) => (
    <>
      {index === 1 && <AdBreak first />}
      {index > 1 && <AdBreak />}
      <section class={`fo-catband fo-cat--${band.category}`} aria-labelledby={band.headingId}>
        <div class="fo-catband__head">
          <h2 class="fo-catband__title" id={band.headingId}>{band.texts.heading}</h2>
          <span class="fo-catband__count">{band.count}</span>
        </div>
        <p class="fo-catband__fact">
          {band.texts.num
            ? <span class="fo-catband__num">{fmt(band.texts.num, band.values)}</span>
            : <span class="fo-catband__num">{band.values['from']} <Icon name="arrow-right" class="fo-icon--inline" /><span class="fo-sr">{t.to}</span> {band.values['to']}</span>}
          {' '}<span class="fo-catband__say">{fmt(band.texts.say, band.values)}</span>
        </p>
        <p class="fo-catband__more">{band.texts.more}</p>
        <ul class="fo-catband__chips">
          {band.chips.map((chip) => (
            <li><a class={`fo-chip fo-cat--${chip.category}`} href={chip.href}><span class="fo-chip__dot" aria-hidden="true"><Icon name={chip.icon} /></span><span>{chip.name}</span></a></li>
          ))}
        </ul>
        {band.links.length > 0 && (
          <p class="fo-catband__links">
            {band.links.map((link) => <a class="fo-catband__all" href={link.href}>{link.text}<Icon name="chevron-right" /></a>)}
          </p>
        )}
      </section>
    </>
  ))}
  {guidesHub && guideCards.length > 0 && (
    <>
    <AdBreak />
    <section class="fo-section" aria-labelledby="guides-home">
      <h2 id="guides-home">{t.guides.heading}</h2>
      <p class="fo-prose">{t.guides.intro}</p>
      <ul class="fo-guidecards">
        {guideCards.map((card) => (
          <li><GuideCard href={card.href} name={card.name} description={card.description} category={card.category} proof={card.proof} tool={card.tool} headingLevel={3} lang={lang} /></li>
        ))}
      </ul>
      <p class="fo-more"><a href={guidesHub}>{fmt(t.guides.hubLink, guideCount)}</a></p>
    </section>
    </>
  )}
  <AdBreak />
  <section class="fo-section fo-prose" aria-labelledby="privacy-home">
    <h2 id="privacy-home">{t.privacyHeading}</h2>
    <p>{t.privacyBody}</p>
  </section>
</BaseLayout>
