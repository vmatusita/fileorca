---
// A guide /guides/<slug>/ (F4, decision 10; DECISOES § 119): breadcrumb Home › Guides › title (F11; before, Home › Money
// calculators › title); H1,
// the line it answers and "Reviewed by" with the dates; the introduction; the embedded calculator, filled
// with the guide's example by property of the page (never by the URL), and its schedule; the text, whose
// every result is filled in by the engines at build (src/tools/calc/guides.ts); one content AdSlot only after
// the calculator; the table the engines measured, with its date; how it works (the data-ymyl blocks of
// gate:dinheiro-saude); the related calculators; the rail AdSlot. Schema: Article, BreadcrumbList, Person. Since the
// languages adjustment it also serves the Spanish guides: the same engines, the numbers and words in Spanish, the Spanish
// calculator embedded, and every link to a Spanish page.
// F12 · o mapa de anúncios (decision 3; DECISOES § 419): the first content ad goes into the text after the calculator,
// with a paragraph between them (after the first paragraph of the first part), and the next ones only at the marks
// between the paragraphs and the parts and in "How it works", never beside the table the engines measured; the layout
// puts each box and the rails (src/ads/map.ts).
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ToolCard from '../components/ToolCard.astro';
import AdBreak from '../ads/AdBreak.astro';
import Reviewed from '../tools/calc/Reviewed.astro';
import CalcIsland from '../tools/calc/CalcIsland.astro';
import { pathFor, routeById } from '../i18n/routes.ts';
import { fmt } from '../i18n/format.ts';
import { TEXTS } from '../i18n/texts.ts';
import { articleLd, breadcrumbLd, homePath, personLd } from '../seo/meta.ts';
import { PANEL_POSES } from '../tools/image/Oli.tsx';
import { GUIDES, guidePathIn, moneyPage, type GuideId } from '../tools/calc/registry.ts';
import { GUIDES_HUB_ID } from '../tools/guides/registry.ts';
import { SHARED_BY_LANG, calcTexts, cardOf, datesOf, longDate, panelData } from '../tools/calc/page.ts';
import { GUIDE_FACTS, GUIDE_TEXTS, type GuideLang } from '../tools/calc/guides.ts';

interface Props {
  id: GuideId;
  lang: GuideLang;
}
const { id, lang } = Astro.props;
const t = GUIDE_TEXTS[id][lang];
const route = routeById(id);
const path = guidePathIn(id, lang) ?? GUIDES[id].path;
const guide = GUIDE_FACTS[id](lang);
// The days of the guide: the English ones of the F4, the Spanish ones of the languages adjustment.
const { reviewed: REVIEWED, first: FIRST_PUBLISHED } = datesOf(id, lang);
const fill = (text: string): string => fmt(text, { ...guide.facts, date: longDate(REVIEWED, lang) });
const data = panelData(guide.calc, lang, { initial: guide.example, readLink: false });
const common = TEXTS[lang].common;
const shared = SHARED_BY_LANG[lang].page;
// F11 (decision 7): Home › Guides › the guide, the guides hub that lists every guide (before, the money hub).
const crumbs = [
  { name: common.breadcrumb.home, path: homePath(lang) },
  { name: common.guidesHub, path: pathFor(GUIDES_HUB_ID, lang) },
  { name: t.h1, path },
];
const related = GUIDES[id].related.map((target) => cardOf(target, lang));
// The calculator the guide embeds, by its own H1, linked under it (review F4, SEO-1): the first letter goes small
// unless the name starts with an acronym ("APR to APY").
const calcH1 = calcTexts(guide.calc, lang).h1;
const calcLabel = /^[A-Z][a-z]/.test(calcH1) ? calcH1[0]!.toLowerCase() + calcH1.slice(1) : calcH1;
const calcPath = moneyPage(guide.calc, lang)?.path ?? '';
const [readBefore, readAfter] = shared.readOn.split('{date}');
const [noteBefore, noteAfter] = t.tableNote.split('{date}');
// The first ad after the first paragraph of the first part, or after that part when it has a single paragraph.
const firstInside = (t.sections[0]?.paragraphs.length ?? 0) > 1;
---
<BaseLayout
  lang={lang}
  route={route}
  title={t.title}
  description={t.description}
  withAds
  adArea="dinheiro"
  oli={PANEL_POSES}
  schema={[breadcrumbLd(crumbs), articleLd(t.h1, t.description, path, lang, FIRST_PUBLISHED, REVIEWED, id), personLd()]}
>
  <Breadcrumb label={common.breadcrumb.label} crumbs={crumbs} />
  <div class="fo-top fo-top--calc">
    <h1 class="fo-h1">{t.h1}</h1>
    <p class="fo-lead">{t.lead}</p>
    <Reviewed lang={lang} of={id} />
  </div>
  <div class="fo-prose fo-guide">{t.intro.map((paragraph) => <p>{fill(paragraph)}</p>)}</div>
  <section class="fo-section fo-prose" aria-labelledby="guide-calc">
    <h2 id="guide-calc">{t.calcHeading}</h2>
    <p>{fill(t.calcIntro)}</p>
  </section>
  <CalcIsland data={data} />
  <p class="fo-guide__open"><a href={calcPath}>{fmt(shared.openCalc, { name: calcLabel })}</a></p>
  {t.sections.map((section, index) => (
    <>
      {index > 0 && <AdBreak first={index === 1 && !firstInside} />}
      <section class="fo-section fo-prose" aria-labelledby={`part-${index}`}>
        <h2 id={`part-${index}`}>{section.heading}</h2>
        {section.paragraphs.map((paragraph, at) => <>{at > 0 && <AdBreak first={index === 0 && at === 1} />}<p>{fill(paragraph)}</p></>)}
      </section>
    </>
  ))}
  <section class="fo-section fo-prose" aria-labelledby="measured">
    <h2 id="measured">{t.tableHeading}</h2>
    <p>{fill(t.tableIntro)}</p>
    <div class="fo-table-wrap" tabindex="0" role="region" aria-label={t.tableCaption}>
      <table class="fo-table">
        <caption class="fo-sr">{t.tableCaption}</caption>
        <thead><tr>{guide.table.head.map((heading) => <th scope="col">{heading}</th>)}</tr></thead>
        <tbody>{guide.table.rows.map((row) => <tr>{row.map((cell, index) => (index === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>))}</tr>)}</tbody>
      </table>
    </div>
    <p class="fo-reviewed">{noteBefore}<time datetime={REVIEWED}>{longDate(REVIEWED, lang)}</time>{noteAfter}</p>
  </section>
  <section class="fo-section fo-prose" aria-labelledby="works">
    <h2 id="works">{t.formulaHeading}</h2>
    <div data-ymyl="formula">{t.formula.map((paragraph, at) => <>{at > 0 && <AdBreak />}<p>{fill(paragraph)}</p></>)}</div>
    <AdBreak />
    <div data-ymyl="premises">
      <h3 class="fo-h3">{t.premisesHeading}</h3>
      <ul>{t.premises.map((premise) => <li>{fill(premise)}</li>)}</ul>
    </div>
    <AdBreak />
    <div data-ymyl="example">
      <h3 class="fo-h3">{t.exampleHeading}</h3>
      {t.example.map((paragraph, at) => <>{at > 0 && <AdBreak />}<p>{fill(paragraph)}</p></>)}
    </div>
    <AdBreak />
    <div data-ymyl="source">
      <h3 class="fo-h3">{t.sourcesHeading}</h3>
      <ul>{t.sources.map((source) => <li><a href={source.href}>{source.label}</a>. {readBefore}<time datetime={REVIEWED}>{longDate(REVIEWED, lang)}</time>{readAfter}</li>)}</ul>
    </div>
    <AdBreak />
    <div data-ymyl="disclaimer">
      <h3 class="fo-h3">{t.disclaimerHeading}</h3>
      <p>{t.disclaimer}</p>
    </div>
  </section>
  <AdBreak />
  <section class="fo-section" aria-labelledby="related">
    <h2 id="related">{t.relatedHeading}</h2>
    <ul class="fo-grid">
      {related.map((card) => (
        <li><ToolCard href={card.href} name={card.name} description={card.description} category="money" icon={card.icon} /></li>
      ))}
    </ul>
  </section>
</BaseLayout>
