---
// The tool page mold for the 12 PDF tools (docs/design/components/ToolPage; F5a, decision 9): breadcrumb, H1 +
// PrivacySeal, the island, the first AdSlot (150 px clearance built in), then the blocks the content gate checks
// (data-content: how, specs, faq, privacy, related) and the rail AdSlot (from 1280 px, not sticky). The same blocks as
// ImageToolPage.astro, with "how it works" in three steps or more.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PrivacySeal from '../../components/PrivacySeal.astro';
import Faq from '../../components/Faq.astro';
import RichText from '../../components/RichText.astro';
import ToolCard from '../../components/ToolCard.astro';
import AdSlot from '../../ads/AdSlot.astro';
import { routeById } from '../../i18n/routes.ts';
import { TEXTS } from '../../i18n/texts.ts';
import { breadcrumbLd, webApplicationLd } from '../../seo/meta.ts';
import { PANEL_POSES } from '../image/Oli.tsx';
import PdfIsland from './PdfIsland.astro';
import { crumbsFor, panelData, relatedFor } from './page.ts';
import { PDF_TOOL_TEXTS } from './texts.ts';
import type { PdfToolId } from './registry.ts';

interface Props {
  id: PdfToolId;
}
const { id } = Astro.props;
const lang = 'en';
const route = routeById(id);
const t = PDF_TOOL_TEXTS[id];
const common = TEXTS[lang].common;
const path = route.paths[lang] ?? '/';
const area = route.adArea ?? 'arquivos';
const crumbs = crumbsFor(id);
const related = relatedFor(id);
const data = panelData(id);
const title = t.title.startsWith(t.h1) ? t.title : `${t.h1}: ${t.title}`;
---
<BaseLayout
  lang={lang}
  route={route}
  title={title}
  description={t.description}
  withAds
  oli={PANEL_POSES}
  schema={[breadcrumbLd(crumbs), webApplicationLd(t.h1, t.description, path, lang)]}
>
  <Breadcrumb label={common.breadcrumb.label} crumbs={crumbs} />
  <div class="fo-top">
    <h1 class="fo-h1">{t.h1}</h1>
    <PrivacySeal text={common.seal} />
  </div>
  <PdfIsland data={data} />
  <AdSlot area={area} variant="content" label={common.adLabel} />
  <section class="fo-section fo-prose" data-content="how" aria-labelledby="how">
    <h2 id="how">{t.howHeading}</h2>
    <ol class="fo-steps">{t.howSteps.map((step) => <li>{step}</li>)}</ol>
  </section>
  <section class="fo-section fo-prose" data-content="specs" aria-labelledby="specs">
    <h2 id="specs">{t.specsHeading}</h2>
    <table class="fo-table">
      <caption class="fo-sr">{t.specs.caption}</caption>
      <thead><tr><th scope="col">{t.specs.head[0]}</th><th scope="col">{t.specs.head[1]}</th></tr></thead>
      <tbody>
        {t.specs.rows.map(([detail, what]) => <tr><th scope="row">{detail}</th><td><RichText text={what} /></td></tr>)}
      </tbody>
    </table>
  </section>
  <section class="fo-section" data-content="faq" aria-labelledby="faq">
    <h2 id="faq">{t.faqHeading}</h2>
    <Faq items={t.faq} />
  </section>
  <section class="fo-section fo-prose" data-content="privacy" aria-labelledby="privacy-note">
    <h2 id="privacy-note">{t.privacyHeading}</h2>
    <p>{t.privacyNote}</p>
  </section>
  <section class="fo-section" data-content="related" aria-labelledby="related">
    <h2 id="related">{t.relatedHeading}</h2>
    <ul class="fo-grid">
      {related.map((card) => (
        <li><ToolCard href={card.href} name={card.name} description={card.description} category={card.category} icon={card.icon} /></li>
      ))}
    </ul>
  </section>
  <AdSlot slot="rail" area={area} variant="rail" label={common.adLabel} />
</BaseLayout>
