---
// The tool page mold for the PDF tools and, since the F18, the PDF presets (docs/design/components/ToolPage; F5a, decision 9;
// F18, decision 5: the same island and entry, so a preset loads the same 2 JS files as its sisters): breadcrumb, H1 +
// PrivacySeal, the island, then the blocks the content gate checks (data-content: how, specs, faq, privacy, related), with
// the ads of the map. The same blocks as ImageToolPage.astro, with "how it works" in three steps or more. The same mold
// serves the three languages (F6). The card of each guide that embeds the tool closes the "How to" block (F11, decision 7;
// DECISOES § 396). F12 · o mapa de anúncios (decision 3; DECISOES § 419): the first content ad after the "How to"
// block (UX-04 A, § 371), the next ones at the marks between the questions and between the last blocks; the layout puts
// each box and the rails (src/ads/map.ts).
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PrivacySeal from '../../components/PrivacySeal.astro';
import Faq from '../../components/Faq.astro';
import RichText from '../../components/RichText.astro';
import ToolCard from '../../components/ToolCard.astro';
import GuideCard from '../../components/GuideCard.astro';
import AdBreak from '../../ads/AdBreak.astro';
import { routeById, type Lang } from '../../i18n/routes.ts';
import { TEXTS } from '../../i18n/texts.ts';
import { breadcrumbLd, webApplicationLd } from '../../seo/meta.ts';
import { FILE_PANEL_POSES } from '../image/Oli.tsx';
import PdfIsland from './PdfIsland.astro';
import { crumbsFor, panelData, presetRows, relatedFor } from './page.ts';
import { PDF_TOOL_TEXTS } from './texts.ts';
import { guidesOfTool } from '../guides/registry.ts';
import { guideCardData } from '../guides/card.ts';
import { PDF_TOOL_IDS, type PdfPageId, type PdfToolId } from './registry.ts';

interface Props {
  id: PdfPageId;
  lang?: Lang;
}
const { id, lang = 'en' } = Astro.props;
const route = routeById(id);
const t = PDF_TOOL_TEXTS[lang][id];
const common = TEXTS[lang].common;
const path = route.paths[lang] ?? '/';
const area = route.adArea ?? 'arquivos';
const crumbs = crumbsFor(id, lang);
const related = relatedFor(id, lang);
const data = panelData(id, lang);
// F18 (decision 5): the table of the presets on a parent page, as the image parents have it (none on a preset).
const presets = presetRows(id, lang);
const title = t.title.startsWith(t.h1) ? t.title : `${t.h1}: ${t.title}`;
// The guides that embed this tool (F5b, decision 6), in the language of the page (DECISOES § 6). F11 (decision 7): each one
// is a GuideCard (--here) at the end of the "How to" block, the first block after the panel; the line "Read the guide"
// between the specs and the questions is gone.
// A preset has no guide of its own (the image presets have none either).
const tool = (PDF_TOOL_IDS as readonly string[]).includes(id) ? (id as PdfToolId) : null;
const guides = tool ? guidesOfTool(tool).map((guide) => guideCardData(guide, lang)) : [];
---
<BaseLayout
  lang={lang}
  route={route}
  title={title}
  description={t.description}
  withAds
  adArea={area}
  oli={FILE_PANEL_POSES}
  schema={[breadcrumbLd(crumbs), webApplicationLd(t.h1, t.description, path, lang)]}
>
  {/* F18 (decision 5): a preset has four steps, and below 360 px the hub step goes, as on an image preset (§ 582). */}
  <Breadcrumb label={common.breadcrumb.label} crumbs={crumbs} skipHub />
  {/* F13a (UX-04 A; F4-F7 f-2; DECISOES § 463): the H1 takes the whole measure; only the seal row leaves room for the Oli. */}
  <div class="fo-top fo-top--tool">
    <h1 class="fo-h1">{t.h1}</h1>
    <div class="fo-top__seal"><PrivacySeal text={common.seal} /></div>
  </div>
  <PdfIsland data={data} />
  <section class="fo-section fo-prose" data-content="how" aria-labelledby="how">
    <h2 id="how">{t.howHeading}</h2>
    <ol class="fo-steps">{t.howSteps.map((step) => <li>{step}</li>)}</ol>
    {guides.length > 0 && (
      <div class="fo-guidehere">
        {guides.map((card) => <GuideCard href={card.href} name={card.name} description={card.description} category={card.category} proof={card.proof} lang={lang} />)}
      </div>
    )}
  </section>
  <AdBreak first />
  <section class="fo-section fo-prose" data-content="specs" aria-labelledby="specs">
    <h2 id="specs">{t.specsHeading}</h2>
    <table class="fo-table">
      <caption class="fo-sr">{t.specs.caption}</caption>
      <thead><tr><th scope="col">{t.specs.head[0]}</th><th scope="col">{t.specs.head[1]}</th></tr></thead>
      <tbody>
        {t.specs.rows.map(([detail, what]) => <tr><th scope="row">{detail}</th><td><RichText text={what} /></td></tr>)}
      </tbody>
    </table>
    {t.presets && presets.length > 0 && (
      <>
        <h3 class="fo-h3" id="presets">{t.presets.heading}</h3>
        {t.presets.lead && <p>{t.presets.lead}</p>}
        <table class="fo-table">
          <caption class="fo-sr">{t.presets.caption}</caption>
          <thead><tr><th scope="col">{t.presets.head[0]}</th><th scope="col">{t.presets.head[1]}</th></tr></thead>
          <tbody>
            {presets.map((preset) => <tr><th scope="row"><a href={preset.href}>{preset.name}</a></th><td>{preset.description}</td></tr>)}
          </tbody>
        </table>
      </>
    )}
  </section>
  <section class="fo-section" data-content="faq" aria-labelledby="faq">
    <h2 id="faq">{t.faqHeading}</h2>
    <Faq items={t.faq} breaks />
  </section>
  <AdBreak />
  <section class="fo-section fo-prose" data-content="privacy" aria-labelledby="privacy-note">
    <h2 id="privacy-note">{t.privacyHeading}</h2>
    <p>{t.privacyNote}</p>
  </section>
  <AdBreak />
  <section class="fo-section" data-content="related" aria-labelledby="related">
    <h2 id="related">{t.relatedHeading}</h2>
    <ul class="fo-grid">
      {related.map((card) => (
        <li><ToolCard href={card.href} name={card.name} description={card.description} category={card.category} icon={card.icon} /></li>
      ))}
    </ul>
  </section>
</BaseLayout>
