---
// Convert to WebP (F17), in the three languages: the shared mold with this tool's panel.
import ImageToolPage from '../image/ImageToolPage.astro';
import ImageToolEmbed from '../image/ImageToolEmbed.astro';
import ConvertToWebpPanel from './Panel.tsx';
import { panelData } from '../image/page.ts';
import type { Lang } from '../../i18n/routes.ts';
import type { ConvertToOptionsTexts } from '../../i18n/types.ts';

interface Props {
  lang: Lang;
  /** Only the island, for the guide that embeds this tool (F19b; DECISOES § 184): the <script> stays here. */
  embed?: boolean;
  /** Options the guide starts the tool with (never the URL). */
  initial?: Record<string, unknown>;
}
const { lang, embed = false, initial } = Astro.props;
const panel = panelData<ConvertToOptionsTexts>('convert-to-webp', lang, initial);
const Mold = embed ? ImageToolEmbed : ImageToolPage;
---
<Mold id="convert-to-webp" lang={lang} panel={panel}>
  <ConvertToWebpPanel slot="panel" {...panel} />
  <script>
    import './mount.ts';
  </script>
</Mold>
