---
// Convert to WebP (English only): the shared mold with this tool's panel.
import ImageToolPage from '../image/ImageToolPage.astro';
import ConvertToWebpPanel from './Panel.tsx';
import { panelData } from '../image/page.ts';
import type { Lang } from '../../i18n/routes.ts';
import type { ConvertToOptionsTexts } from '../../i18n/types.ts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const panel = panelData<ConvertToOptionsTexts>('convert-to-webp', lang);
---
<ImageToolPage id="convert-to-webp" lang={lang} panel={panel}>
  <ConvertToWebpPanel slot="panel" {...panel} />
  <script>
    import './mount.ts';
  </script>
</ImageToolPage>
