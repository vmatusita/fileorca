---
// Remove EXIF data (F18, decision 10), in the three languages: the shared mold with this tool's panel.
import ImageToolPage from '../image/ImageToolPage.astro';
import RemoveExifPanel from './Panel.tsx';
import { panelData } from '../image/page.ts';
import type { Lang } from '../../i18n/routes.ts';
import type { NoteOptionsTexts } from '../../i18n/types.ts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const panel = panelData<NoteOptionsTexts>('remove-exif-data', lang);
---
<ImageToolPage id="remove-exif-data" lang={lang} panel={panel}>
  <RemoveExifPanel slot="panel" {...panel} />
  <script>
    import './mount.ts';
  </script>
</ImageToolPage>
