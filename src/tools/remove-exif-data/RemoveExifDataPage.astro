---
// Remove EXIF data (F18, decision 10), in the three languages: the shared mold with this tool's panel. With `embed`, only
// the island, for the guide "How to remove location data from photos" that embeds this tool (DECISOES § 184 and § 733):
// the <script> stays here, so both load the same entry. No `initial`: the tool has no option to set.
import ImageToolPage from '../image/ImageToolPage.astro';
import ImageToolEmbed from '../image/ImageToolEmbed.astro';
import RemoveExifPanel from './Panel.tsx';
import { panelData } from '../image/page.ts';
import type { Lang } from '../../i18n/routes.ts';
import type { NoteOptionsTexts } from '../../i18n/types.ts';

interface Props {
  lang: Lang;
  /** Only the island, for a guide. */
  embed?: boolean;
}
const { lang, embed = false } = Astro.props;
const panel = panelData<NoteOptionsTexts>('remove-exif-data', lang);
const Mold = embed ? ImageToolEmbed : ImageToolPage;
---
<Mold id="remove-exif-data" lang={lang} panel={panel}>
  <RemoveExifPanel slot="panel" {...panel} />
  <script>
    import './mount.ts';
  </script>
</Mold>
