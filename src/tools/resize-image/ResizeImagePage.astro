---
// Resize image (English only): the shared mold with this tool's panel.
import ImageToolPage from '../image/ImageToolPage.astro';
import ResizePanel from './Panel.tsx';
import { panelData } from '../image/page.ts';
import type { Lang } from '../../i18n/routes.ts';
import type { ResizeOptionsTexts } from '../../i18n/types.ts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const panel = panelData<ResizeOptionsTexts>('resize-image', lang);
---
<ImageToolPage id="resize-image" lang={lang} panel={panel}>
  <ResizePanel slot="panel" {...panel} />
  <script>
    import './mount.ts';
  </script>
</ImageToolPage>
