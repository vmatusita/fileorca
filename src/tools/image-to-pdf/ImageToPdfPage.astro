---
// Image to PDF (English only): the shared mold with this tool's panel.
import ImageToolPage from '../image/ImageToolPage.astro';
import ImageToPdfPanel from './Panel.tsx';
import { panelData } from '../image/page.ts';
import type { Lang } from '../../i18n/routes.ts';
import type { PdfOptionsTexts } from '../../i18n/types.ts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const panel = panelData<PdfOptionsTexts>('image-to-pdf', lang);
---
<ImageToolPage id="image-to-pdf" lang={lang} panel={panel}>
  <ImageToPdfPanel slot="panel" {...panel} />
  <script>
    import './mount.ts';
  </script>
</ImageToolPage>
