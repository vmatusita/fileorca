---
// The signature of a file guide, one line under the lead (prompt F5b, decision 4; PLANO "Conteúdo de apoio"; F13b, G-23
// and F5b F-13, DECISOES § 557): the author and the short date of the review, as <time datetime>. Until the F13b it was
// two sentences with the long dates of the review and of the first publication and what the review changed; the first
// publication and what changed went to the history line at the end of "What we measured" (FileGuideView). No data-ymyl:
// the file guides are in the ad area "arquivos", outside gate:dinheiro-saude.
// F19a (decision 6; DECISOES § 763): the name is a link to the About of the language; the line keeps its one <time>.
import { pathFor, type Lang } from '../../i18n/routes.ts';
import { shortDate } from '../../i18n/dates.ts';
import { AUTHOR } from '../../platform/site.ts';
import { GUIDE_REVIEWED_ON, GUIDE_SHARED } from './page.ts';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const reviewed = GUIDE_REVIEWED_ON[lang];
// "Reviewed by {name} · {date}": the name before the date in every language.
const [before = '', rest = ''] = GUIDE_SHARED[lang].reviewed.split('{name}');
const [between = '', after = ''] = rest.split('{date}');
---
<p class="fo-reviewed fo-sig">{before}<a href={pathFor('about', lang)} rel="author">{AUTHOR.name}</a>{between}<time datetime={reviewed}>{shortDate(reviewed, lang)}</time>{after}</p>
