---
// PNG to JPG (English only): the shared mold with this tool's panel.
import ImageToolPage from '../image/ImageToolPage.astro';
import PngToJpgPanel from './Panel.tsx';
import { panelData } from '../image/page.ts';
import type { Lang } from '../../i18n/routes.ts';
import type { NoteOptionsTexts } from '../../i18n/types.ts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const panel = panelData<NoteOptionsTexts>('png-to-jpg', lang);
---
<ImageToolPage id="png-to-jpg" lang={lang} panel={panel}>
  <PngToJpgPanel slot="panel" {...panel} />
  <script>
    import './mount.ts';
  </script>
</ImageToolPage>
