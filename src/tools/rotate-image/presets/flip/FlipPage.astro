---
// Flip image (F18, decision 9), in the three languages: the shared mold with the preset's own panel and texts.
import ImageToolPage from '../../../image/ImageToolPage.astro';
import FlipPanel from './Panel.tsx';
import { panelData } from '../../../image/page.ts';
import type { Lang } from '../../../../i18n/routes.ts';
import type { FlipOptionsTexts } from '../../../../i18n/types.ts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const panel = panelData<FlipOptionsTexts>('rotate-image-flip', lang);
---
<ImageToolPage id="rotate-image-flip" lang={lang} panel={panel}>
  <FlipPanel slot="panel" {...panel} />
  <script>
    import './mount.ts';
  </script>
</ImageToolPage>
