---
// HEIC to JPG (English only): the shared mold with this tool's panel. With `embed`, only the
// island, for the guide that embeds this tool (DECISOES § 184): the <script> stays here, so both load the same entry.
import ImageToolPage from '../image/ImageToolPage.astro';
import ImageToolEmbed from '../image/ImageToolEmbed.astro';
import HeicToJpgPanel from './Panel.tsx';
import { panelData } from '../image/page.ts';
import type { Lang } from '../../i18n/routes.ts';
import type { SaveAsOptionsTexts } from '../../i18n/types.ts';

interface Props {
  lang: Lang;
  /** Only the island, for a guide. */
  embed?: boolean;
  /** Options the guide starts the tool with (never the URL). */
  initial?: Record<string, unknown>;
}
const { lang, embed = false, initial } = Astro.props;
const panel = panelData<SaveAsOptionsTexts>('heic-to-jpg', lang, initial);
const Mold = embed ? ImageToolEmbed : ImageToolPage;
---
<Mold id="heic-to-jpg" lang={lang} panel={panel}>
  <HeicToJpgPanel slot="panel" {...panel} />
  <script>
    import './mount.ts';
  </script>
</Mold>
