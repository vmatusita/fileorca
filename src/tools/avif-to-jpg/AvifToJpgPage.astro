---
// AVIF to JPG (F17), in the three languages: the shared mold with this tool's panel.
import ImageToolPage from '../image/ImageToolPage.astro';
import AvifToJpgPanel from './Panel.tsx';
import { panelData } from '../image/page.ts';
import type { Lang } from '../../i18n/routes.ts';
import type { NoteOptionsTexts } from '../../i18n/types.ts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const panel = panelData<NoteOptionsTexts>('avif-to-jpg', lang);
---
<ImageToolPage id="avif-to-jpg" lang={lang} panel={panel}>
  <AvifToJpgPanel slot="panel" {...panel} />
  <script>
    import './mount.ts';
  </script>
</ImageToolPage>
