---
// The QR code generator page (prompt F7, decision 8), on the tool page mold of the image tools (ImageToolPage.astro)
// without what is about files: breadcrumb Home › QR code generator (no hub), H1 + PrivacySeal, the island, the blocks the
// content gate checks (data-content: how, specs, faq, privacy, related) with the ads of the map (F12, decision 3; DECISOES
// § 419: the first content ad after the "How to" block, the next ones at the marks between the questions and between
// the last blocks; the layout puts each box and the rails). The <script> that imports mount.ts lives here and only here: a second
// <script> with the same module would make a third JS file (DECISOES § 184). It serves the page of each language (en, and
// pt and es since the languages adjustment), with the texts of that language.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PrivacySeal from '../../components/PrivacySeal.astro';
import Faq from '../../components/Faq.astro';
import RichText from '../../components/RichText.astro';
import ToolCard from '../../components/ToolCard.astro';
import AdBreak from '../../ads/AdBreak.astro';
import { QR_ID, routeById, type Lang } from '../../i18n/routes.ts';
import { TEXTS } from '../../i18n/texts.ts';
import { breadcrumbLd, homePath, webApplicationLd } from '../../seo/meta.ts';
import { PANEL_POSES } from '../image/Oli.tsx';
import QrPanel from './QrPanel.tsx';
import { QR_TEXTS, qrRelated } from './page.ts';
import type { QrPanelData } from './types.ts';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const route = routeById(QR_ID);
const t = QR_TEXTS[lang];
const common = TEXTS[lang].common;
const path = route.paths[lang] ?? '/';
const area = route.adArea ?? 'utilidades';
const name = common.qr?.name ?? t.h1;
const crumbs = [
  { name: common.breadcrumb.home, path: homePath(lang) },
  { name: t.h1, path },
];
const related = qrRelated(lang);
const panel: QrPanelData = { lang, t: t.panel };
---
<BaseLayout
  lang={lang}
  route={route}
  title={t.title}
  description={t.description}
  withAds
  adArea={area}
  oli={PANEL_POSES}
  schema={[breadcrumbLd(crumbs), webApplicationLd(name, t.description, path, lang, 'UtilitiesApplication')]}
>
  <Breadcrumb label={common.breadcrumb.label} crumbs={crumbs} />
  <div class="fo-top">
    <h1 class="fo-h1">{t.h1}</h1>
    <PrivacySeal text={t.seal} />
  </div>
  <div id="fo-tool-root" data-props={JSON.stringify(panel)}><QrPanel {...panel} /></div>
  <section class="fo-section fo-prose" data-content="how" aria-labelledby="how">
    <h2 id="how">{t.howHeading}</h2>
    <ol class="fo-steps">{t.howSteps.map((step) => <li>{step}</li>)}</ol>
  </section>
  <AdBreak first />
  <section class="fo-section fo-prose" data-content="specs" aria-labelledby="specs">
    <h2 id="specs">{t.specsHeading}</h2>
    <table class="fo-table">
      <caption class="fo-sr">{t.specs.caption}</caption>
      <thead><tr><th scope="col">{t.specs.head[0]}</th><th scope="col">{t.specs.head[1]}</th></tr></thead>
      <tbody>
        {t.specs.rows.map(([detail, what]) => <tr><th scope="row">{detail}</th><td><RichText text={what} /></td></tr>)}
      </tbody>
    </table>
  </section>
  <section class="fo-section" data-content="faq" aria-labelledby="faq">
    <h2 id="faq">{t.faqHeading}</h2>
    <Faq items={t.faq} breaks />
  </section>
  <AdBreak />
  <section class="fo-section fo-prose" data-content="privacy" aria-labelledby="privacy-note">
    <h2 id="privacy-note">{t.privacyHeading}</h2>
    <p>{t.privacyNote}</p>
  </section>
  <AdBreak />
  <section class="fo-section" data-content="related" aria-labelledby="related">
    <h2 id="related">{t.relatedHeading}</h2>
    <ul class="fo-grid">
      {related.map((card) => (
        <li><ToolCard href={card.href} name={card.name} description={card.description} category={card.category} icon={card.icon} /></li>
      ))}
    </ul>
  </section>
  <script>
    import './mount.ts';
  </script>
</BaseLayout>
