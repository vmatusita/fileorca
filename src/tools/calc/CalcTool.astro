---
// The calculator page mold (PLANO "Molde da página de calculadora"; DECISOES § 117), shared by the 14
// calculators and the 4 presets: breadcrumb; H1, the line it answers and "Reviewed by" (data-ymyl
// "reviewed"); the island (fields, result, ExportBar, scenarios, the schedule since the F13b, chips); the first AdSlot,
// 150 px from the chips; how to use; how it works (formula, assumptions, worked example from the
// engine, official sources, educational notice: the data-ymyl blocks of gate:dinheiro-saude); the presets
// table; the questions; the privacy note; the related grid; the rail AdSlot. The calculator that a guide embeds shows the
// GuideCard of that guide (--here) at the end of "How to", right after the first ad (the schedule takes nothing inside; F11,
// decision 7; DECISOES § 396): before, a line "Read the guide" sat in the "how it works" block. It serves the English pages, their
// Spanish versions and the Brazilian calculators, each in its language; the presets and guides only in English (F6).
// F12 · o mapa de anúncios (decision 3; DECISOES § 419): the first content ad stays after the panel (fields, result,
// the schedule and chips; F13b, DECISOES § C-5), never between the fields nor inside the schedule; the next ones only at the marks of
// "How it works" (between its blocks and its paragraphs, never after a heading nor against a table) and between the
// questions and the last blocks; the layout puts each box and the rails (src/ads/map.ts).
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import PrivacySeal from '../../components/PrivacySeal.astro';
import Faq from '../../components/Faq.astro';
import ToolCard from '../../components/ToolCard.astro';
import GuideCard from '../../components/GuideCard.astro';
import AdBreak from '../../ads/AdBreak.astro';
import { routeById, type Lang } from '../../i18n/routes.ts';
import { TEXTS } from '../../i18n/texts.ts';
import { breadcrumbLd, personLd, webApplicationLd } from '../../seo/meta.ts';
import { CALC_POSES } from '../../oli/poses.ts';
import CalcIsland from './CalcIsland.astro';
import Reviewed from './Reviewed.astro';
import { SHARED_BY_LANG, calcTexts, crumbsFor, datesOf, longDate, panelData, presetRows, relatedFor, workedExample } from './page.ts';
import { CALC_PAGES, calcAreaOf, guidePathIn, isCalcPage, type AnyCalcId } from './registry.ts';
import { guideCardData } from '../guides/card.ts';

interface Props {
  id: AnyCalcId;
  lang: Lang;
}
const { id, lang } = Astro.props;
const route = routeById(id);
const t = calcTexts(id, lang);
const shared = SHARED_BY_LANG[lang].page;
const dates = datesOf(id, lang);
const read = dates.read;
// The area of the page (F7): the ad area, the category colour, the schema and the Oli's poses (no cheer on health).
const area = calcAreaOf(id);
const adArea = area === 'money' ? 'dinheiro' : 'casa-saude';
const category = area === 'money' ? 'money' : 'home';
const appCategory = area === 'money' ? 'FinanceApplication' : area === 'health' ? 'HealthApplication' : 'UtilitiesApplication';
const poses = area === 'health' ? CALC_POSES.filter((pose) => pose !== 'cheer') : [...CALC_POSES];
const common = TEXTS[lang].common;
const path = route.paths[lang] ?? '/';
const data = panelData(id, lang);
const crumbs = crumbsFor(id, lang);
const related = relatedFor(id, lang);
const presets = presetRows(id, lang);
// The guide of the calculator, where it exists in the language (English and Spanish; never in pt).
const guideId = isCalcPage(id) ? CALC_PAGES[id].guide : undefined;
const guide = guideId && guidePathIn(guideId, lang) !== null ? guideCardData(guideId, lang) : null;
const example = workedExample(id, lang);
const [readBefore, readAfter] = shared.readOn.split('{date}');
const [firstBefore, firstAfter] = shared.firstPublished.split('{date}');
---
<BaseLayout
  lang={lang}
  route={route}
  title={t.title}
  description={t.description}
  withAds
  adArea={adArea}
  oli={poses}
  seal={shared.seal}
  schema={[breadcrumbLd(crumbs), webApplicationLd(t.h1, t.description, path, lang, appCategory), personLd()]}
>
  <Breadcrumb label={common.breadcrumb.label} crumbs={crumbs} />
  <div class="fo-top fo-top--calc fo-top--calcpage">
    <h1 class="fo-h1">{t.h1}</h1>
    <p class="fo-lead">{t.lead}</p>
    <Reviewed lang={lang} of={id} line />
    <PrivacySeal text={shared.seal} />
  </div>
  <CalcIsland data={data} />
  <AdBreak first />
  <section class="fo-section fo-prose" data-content="how" aria-labelledby="how">
    <h2 id="how">{t.howHeading}</h2>
    <ol class="fo-steps">{t.howSteps.map((step) => <li>{step}</li>)}</ol>
    {guide && (
      <div class="fo-guidehere">
        <GuideCard href={guide.href} name={guide.name} description={guide.description} category={guide.category} proof={guide.proof} lang={lang} />
      </div>
    )}
  </section>
  {t.own?.map((block, index) => (
    <>
      <AdBreak />
      <section class="fo-section fo-prose" data-content="own" aria-labelledby={`own-${index}`}>
        <h2 id={`own-${index}`}>{block.heading}</h2>
        {block.paragraphs.map((paragraph, at) => <>{at > 0 && <AdBreak />}<p>{paragraph}</p></>)}
      </section>
    </>
  ))}
  <AdBreak />
  <section class="fo-section fo-prose" data-content="works" aria-labelledby="works">
    <h2 id="works">{t.worksHeading}</h2>
    <div data-ymyl="formula">
      <h3 class="fo-h3">{t.formulaHeading}</h3>
      {t.formula.map((paragraph, at) => <>{at > 0 && <AdBreak />}<p>{paragraph}</p></>)}
    </div>
    <AdBreak />
    <div data-ymyl="premises">
      <h3 class="fo-h3">{t.premisesHeading}</h3>
      <ul>{t.panel.premises.map((premise) => <li>{premise}</li>)}</ul>
    </div>
    <AdBreak />
    <div data-ymyl="example">
      <h3 class="fo-h3">{t.exampleHeading}</h3>
      <p>{t.exampleIntro}</p>
      <div class="fo-example">
        {[[shared.exampleInputs, example.inputs], [shared.exampleResults, example.results]].map(([caption, rows]) => (
          <table class="fo-table">
            <caption>{caption as string}</caption>
            <tbody>{(rows as [string, string][]).map(([label, value]) => <tr><th scope="row">{label}</th><td class:list={[{ 'fo-example__whole': !value.includes(' ') }]}>{value}</td></tr>)}</tbody>
          </table>
        ))}
      </div>
      <p>{example.sentence}</p>
    </div>
    <AdBreak />
    <div data-ymyl="source">
      <h3 class="fo-h3">{t.sourcesHeading}</h3>
      <ul>{t.sources.map((source) => <li><a href={source.href}>{source.label}</a>. {readBefore}<time datetime={read}>{longDate(read, lang)}</time>{readAfter}</li>)}</ul>
      {/* F13b (G-23; DECISOES § C-1): the first publication, which the one-line signature of the top leaves out. */}
      <p class="fo-reviewed">{firstBefore}<time datetime={dates.first}>{longDate(dates.first, lang)}</time>{firstAfter}</p>
    </div>
    <AdBreak />
    <div data-ymyl="disclaimer">
      <h3 class="fo-h3">{shared.disclaimerHeading}</h3>
      <p>{t.disclaimer}</p>
    </div>
  </section>
  <AdBreak />
  {t.presets && presets.length > 0 && (
    <section class="fo-section fo-prose" aria-labelledby="presets">
      <h2 id="presets">{t.presets.heading}</h2>
      <table class="fo-table">
        <caption class="fo-sr">{t.presets.caption}</caption>
        <thead><tr><th scope="col">{t.presets.head[0]}</th><th scope="col">{t.presets.head[1]}</th></tr></thead>
        <tbody>{presets.map((preset) => <tr><th scope="row"><a href={preset.href}>{preset.name}</a></th><td>{preset.description}</td></tr>)}</tbody>
      </table>
    </section>
  )}
  <section class="fo-section" data-content="faq" aria-labelledby="faq">
    <h2 id="faq">{t.faqHeading}</h2>
    <Faq items={t.faq} breaks />
  </section>
  <AdBreak />
  <section class="fo-section fo-prose" data-content="privacy" aria-labelledby="privacy-note">
    <h2 id="privacy-note">{t.privacyHeading}</h2>
    <p>{t.privacyNote}</p>
  </section>
  <AdBreak />
  <section class="fo-section" data-content="related" aria-labelledby="related">
    <h2 id="related">{t.relatedHeading}</h2>
    <ul class="fo-grid">
      {related.map((card) => (
        <li><ToolCard href={card.href} name={card.name} description={card.description} category={category} icon={card.icon} /></li>
      ))}
    </ul>
  </section>
</BaseLayout>
