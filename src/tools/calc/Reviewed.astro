---
// The "Reviewed by" line of every money page (PLANO "Confiança em dinheiro e saúde"): the author, the date
// of the review and the date of first publication, as <time datetime> (gate:dinheiro-saude, "reviewed"), in the
// language of the page (the Spanish and Brazilian pages were born in the F6).
// F13b (UX-12 A, G-23; DECISOES § 544): a calculator page signs in one line, the name and the short date ("Reviewed by
// Victor Yuki Matusita · Oct 31, 2026"), and its "First published" goes down to the block of the sources (<FirstPublished>).
// The hubs and the money guides keep the two sentences of before (their molds do not change in this run).
// F19a (decision 6; DECISOES § 763): in both forms the name is a link to the About of the language; the dates stay.
import { pathFor, type Lang } from '../../i18n/routes.ts';
import { shortDate } from '../../i18n/dates.ts';
import { AUTHOR } from '../../platform/site.ts';
import { SHARED_BY_LANG, datesOf, longDate } from './page.ts';
import type { AnyCalcId, CalcArea, GuideId } from './registry.ts';

interface Props {
  lang?: Lang;
  /** The page (or the hub's area): the home and health pages carry the days of the F7. */
  of?: AnyCalcId | CalcArea | GuideId;
  /** One line: the name and the short date of the review (a calculator page). */
  line?: boolean;
}
const { lang = 'en', of = 'money', line = false } = Astro.props;
const shared = SHARED_BY_LANG[lang].page;
const { reviewed, first } = datesOf(of, lang);
const about = pathFor('about', lang);
// "Reviewed by {name} on {date}." and "Reviewed by {name} · {date}": the name before the date in every language.
const [byName = '', byRest = ''] = shared.reviewed.split('{name}');
const [byBefore = '', byAfter = ''] = byRest.split('{date}');
const [firstBefore, firstAfter = ''] = shared.firstPublished.split('{date}');
const [signName = '', signRest = ''] = shared.signed.split('{name}');
const [signBefore = '', signAfter = ''] = signRest.split('{date}');
---
{line ? (
  <p class="fo-reviewed fo-reviewed--line" data-ymyl="reviewed">
    {signName}<a href={about} rel="author">{AUTHOR.name}</a>{signBefore}<time datetime={reviewed}>{shortDate(reviewed, lang)}</time>{signAfter}
  </p>
) : (
  <p class="fo-reviewed" data-ymyl="reviewed">
    {byName}<a href={about} rel="author">{AUTHOR.name}</a>{byBefore}<time datetime={reviewed}>{longDate(reviewed, lang)}</time>{`${byAfter} `}{firstBefore}<time datetime={first}>{longDate(first, lang)}</time>{firstAfter}
  </p>
)}
