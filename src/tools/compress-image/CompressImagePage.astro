---
// Compress image in English, Portuguese and Spanish: the shared mold with this tool's panel.
import ImageToolPage from '../image/ImageToolPage.astro';
import CompressPanel from './Panel.tsx';
import { panelData } from '../image/page.ts';
import type { Lang } from '../../i18n/routes.ts';
import type { CompressOptionsTexts } from '../../i18n/types.ts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const panel = panelData<CompressOptionsTexts>('compress-image', lang);
---
<ImageToolPage id="compress-image" lang={lang} panel={panel}>
  <CompressPanel slot="panel" {...panel} />
  <script>
    import './mount.ts';
  </script>
</ImageToolPage>
