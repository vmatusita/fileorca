---
// Crop image (English only): the shared mold with this tool's panel.
import ImageToolPage from '../image/ImageToolPage.astro';
import CropPanel from './Panel.tsx';
import { panelData } from '../image/page.ts';
import type { Lang } from '../../i18n/routes.ts';
import type { CropOptionsTexts } from '../../i18n/types.ts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const panel = panelData<CropOptionsTexts>('crop-image', lang);
---
<ImageToolPage id="crop-image" lang={lang} panel={panel}>
  <CropPanel slot="panel" {...panel} />
  <script>
    import './mount.ts';
  </script>
</ImageToolPage>
