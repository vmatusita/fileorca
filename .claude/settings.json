{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push * *:main)",
      "Bash(git push * *:main *)",
      "Bash(git push * refs/heads/main*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git push --no-verify*)",
      "Bash(git push * --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit --amend*)",
      "Bash(git commit * --amend*)",
      "Bash(git reset --hard*)",
      "Bash(git config core.hooksPath*)",
      "Bash(git config * core.hooksPath*)",
      "Bash(git config --unset core.hooksPath*)",
      "Bash(gh pr merge*)",
      "Bash(gh repo create*)",
      "Bash(gh repo edit*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo rename*)",
      "Bash(gh secret *)",
      "Bash(gh variable *)",
      "Bash(gh api * -X *)",
      "Bash(gh api -X *)",
      "Bash(gh api * --method *)",
      "Bash(gh api --method *)",
      "Bash(wrangler deploy*)",
      "Bash(wrangler versions deploy*)",
      "Bash(wrangler secret*)",
      "Bash(wrangler login*)",
      "Bash(npx wrangler deploy*)",
      "Bash(npx wrangler versions deploy*)",
      "Bash(npx wrangler secret*)",
      "Bash(npx wrangler login*)",
      "Bash(pnpm wrangler deploy*)",
      "Bash(pnpm exec wrangler deploy*)",
      "Bash(pnpm dlx wrangler deploy*)",
      "Edit(/.githooks/**)",
      "Edit(/.claude/settings.json)",
      "Edit(/PLANO-FILEORCA.md)",
      "Edit(/docs/adr/ADR-001-plataforma-de-entrega.md)"
    ]
  }
}
